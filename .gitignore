# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Tests, coverage, and type checking
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.pyright/

# Packaging
build/
dist/
*.egg-info/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# External and generated ingestion payloads are never committed by default.
data/raw/*
!data/raw/.gitkeep
data/normalized/*
!data/normalized/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/deduplicated/*
!data/deduplicated/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Editor and operating-system files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local agent worktrees
.claude/worktrees/

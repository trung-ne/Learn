{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m10-revision-request.schema.json",
  "title": "English Master M10 canonical revision request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "source_milestone",
    "target_milestone",
    "revision_number",
    "subject_id",
    "content_type",
    "lesson_id",
    "predecessor",
    "source_inputs",
    "findings",
    "repair_constraints",
    "acceptance_checks",
    "rebuild_closure",
    "planning_only",
    "successor_created",
    "lifecycle_transition_authorized",
    "approval_claim_authorized",
    "content_lifecycle_status",
    "development_approved"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "m10_revision_request"},
    "request_id": {"type": "string", "pattern": "^m10request_[a-f0-9]{64}$"},
    "source_milestone": {"const": "M9"},
    "target_milestone": {"enum": ["M6", "M7", "M8_2"]},
    "revision_number": {"const": 2},
    "subject_id": {"type": "string", "pattern": "^m9sub_[a-f0-9]{64}$"},
    "content_type": {"enum": ["LESSON", "EXERCISE_SET", "AI_PRACTICE_PROMPT"]},
    "lesson_id": {"$ref": "common.schema.json#/$defs/lessonId"},
    "modality": {"enum": ["LISTENING", "SPEAKING", "PRONUNCIATION", "WRITING"]},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceInput"}
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verbatimFinding"}
    },
    "repair_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repairConstraint"}
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/acceptanceCheck"}
    },
    "rebuild_closure": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rebuildStep"}
    },
    "planning_only": {"const": true},
    "successor_created": {"const": false},
    "lifecycle_transition_authorized": {"const": false},
    "approval_claim_authorized": {"const": false},
    "content_lifecycle_status": {"const": "UNREVIEWED"},
    "development_approved": {"const": false}
  },
  "$defs": {
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256", "audit_path", "audit_sha256"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "audit_path": {"type": "string", "minLength": 1},
        "audit_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "input_sha256", "review_role"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^m10input_[a-f0-9]{64}$"},
        "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "review_role": {"enum": ["LINGUISTIC_AI_REVIEWER", "PEDAGOGICAL_AI_REVIEWER"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "category", "description"],
      "properties": {
        "severity": {"enum": ["MINOR", "MAJOR", "CRITICAL"]},
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string"}
      }
    },
    "verbatimFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_input_id", "source_input_sha256", "review_role", "finding_index", "finding"],
      "properties": {
        "source_input_id": {"type": "string", "pattern": "^m10input_[a-f0-9]{64}$"},
        "source_input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "review_role": {"enum": ["LINGUISTIC_AI_REVIEWER", "PEDAGOGICAL_AI_REVIEWER"]},
        "finding_index": {"type": "integer", "minimum": 0},
        "finding": {"$ref": "#/$defs/finding"}
      }
    },
    "repairConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_input_id", "finding_index", "requirement", "scope_boundary"],
      "properties": {
        "source_input_id": {"type": "string", "pattern": "^m10input_[a-f0-9]{64}$"},
        "finding_index": {"type": "integer", "minimum": 0},
        "requirement": {"type": "string", "minLength": 1},
        "scope_boundary": {"type": "string", "minLength": 1}
      }
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_code", "requirement"],
      "properties": {
        "check_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "requirement": {"type": "string", "minLength": 1},
        "source_input_id": {"type": "string", "pattern": "^m10input_[a-f0-9]{64}$"},
        "finding_index": {"type": "integer", "minimum": 0}
      }
    },
    "rebuildStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_milestone", "artifact_kind", "scope"],
      "properties": {
        "target_milestone": {"enum": ["M7", "M8_2"]},
        "artifact_kind": {"enum": ["EXERCISE_SET", "AI_PRACTICE_PILOT"]},
        "scope": {"enum": ["SUBJECT_LESSON", "FULL_CLOSED_PILOT"]},
        "lesson_id": {"$ref": "common.schema.json#/$defs/lessonId"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"content_type": {"const": "LESSON"}}, "required": ["content_type"]},
      "then": {
        "properties": {
          "target_milestone": {"const": "M6"},
          "rebuild_closure": {
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "properties": {
                  "target_milestone": {"const": "M7"},
                  "artifact_kind": {"const": "EXERCISE_SET"},
                  "scope": {"const": "SUBJECT_LESSON"}
                },
                "required": ["lesson_id"]
              },
              {
                "properties": {
                  "target_milestone": {"const": "M8_2"},
                  "artifact_kind": {"const": "AI_PRACTICE_PILOT"},
                  "scope": {"const": "FULL_CLOSED_PILOT"}
                },
                "not": {"required": ["lesson_id"]}
              }
            ]
          }
        },
        "not": {"required": ["modality"]}
      }
    },
    {
      "if": {"properties": {"content_type": {"const": "EXERCISE_SET"}}, "required": ["content_type"]},
      "then": {
        "properties": {
          "target_milestone": {"const": "M7"},
          "rebuild_closure": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "properties": {
                  "target_milestone": {"const": "M7"},
                  "artifact_kind": {"const": "EXERCISE_SET"},
                  "scope": {"const": "SUBJECT_LESSON"}
                },
                "required": ["lesson_id"]
              }
            ]
          }
        },
        "not": {"required": ["modality"]}
      }
    },
    {
      "if": {"properties": {"content_type": {"const": "AI_PRACTICE_PROMPT"}}, "required": ["content_type"]},
      "then": {
        "properties": {
          "target_milestone": {"const": "M8_2"},
          "rebuild_closure": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "properties": {
                  "target_milestone": {"const": "M8_2"},
                  "artifact_kind": {"const": "AI_PRACTICE_PILOT"},
                  "scope": {"const": "FULL_CLOSED_PILOT"}
                },
                "not": {"required": ["lesson_id"]}
              }
            ]
          }
        },
        "required": ["modality"]
      }
    }
  ]
}

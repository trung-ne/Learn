{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/listening-acoustic-fixture-sidecar.schema.json",
  "title": "English Master M14 Acoustic Fixture Sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "sidecar_id", "payload_sha256",
    "transcription_id", "transcription_sha256", "transcription_run_id",
    "transcription_manifest_sha256", "transcription_verification_id",
    "transcription_verification_sha256", "transcript_artifact_id",
    "transcript_artifact_sha256", "media_run_id", "media_asset_id",
    "media_payload_sha256", "evidence_origin", "feature_annotations",
    "fixture_only", "network_accessed", "media_accessed", "model_accessed", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "listening_acoustic_fixture_sidecar"},
    "sidecar_id": {"type": "string", "pattern": "^ldacoustic_[a-f0-9]{64}$"},
    "payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "transcription_id": {"type": "string", "pattern": "^ldtx_[a-f0-9]{64}$"},
    "transcription_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "transcription_run_id": {"type": "string", "pattern": "^transrun_[a-f0-9]{64}$"},
    "transcription_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "transcription_verification_id": {"type": "string", "pattern": "^transverify_[a-f0-9]{64}$"},
    "transcription_verification_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "transcript_artifact_id": {"type": "string", "pattern": "^transcript_[a-f0-9]{64}$"},
    "transcript_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "media_run_id": {"type": "string", "pattern": "^mediarun_[a-f0-9]{64}$"},
    "media_asset_id": {"type": "string", "pattern": "^mediaasset_[a-f0-9]{64}$"},
    "media_payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "evidence_origin": {"const": "SYNTHETIC_ACOUSTIC_FIXTURE"},
    "feature_annotations": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"$ref": "#/$defs/featureAnnotation"}
    },
    "fixture_only": {"const": true},
    "network_accessed": {"const": false},
    "media_accessed": {"const": false},
    "model_accessed": {"const": false},
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "$defs": {
    "featureAnnotation": {
      "type": "object", "additionalProperties": false,
      "required": ["feature", "score", "confidence", "fixture_evidence", "method", "limitations"],
      "properties": {
        "feature": {"enum": ["reductions", "connected_speech", "accent", "noise"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"enum": ["LOW", "MEDIUM"]},
        "fixture_evidence": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_record_id", "locator", "statement"],
            "properties": {
              "fixture_record_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "locator": {"type": "string", "minLength": 1, "maxLength": 300},
              "statement": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          }
        },
        "method": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "parameters"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "version": {"type": "string", "minLength": 1, "maxLength": 100},
            "parameters": {"type": "object", "maxProperties": 20}
          }
        },
        "limitations": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}

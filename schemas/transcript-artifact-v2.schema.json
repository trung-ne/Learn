{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/transcript-artifact-v2.schema.json",
  "title": "English Master M13 Hardened Fixture Transcript Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "artifact_id", "authorization_id", "authorization_sha256", "request_id", "request_sha256", "processing_plan_id", "processing_plan_sha256", "media_run_id", "media_asset_id", "media_payload_sha256", "source_id", "source_record_id", "language", "media_duration_ms", "segments", "speaker_labels", "full_text", "full_text_sha256", "generated_at", "generation_method", "tool", "model", "parameters", "permissions_validated", "parent_media_read", "media_transformed", "audio_extracted", "external_process_invoked", "fixture_only", "network_accessed", "provider_invoked", "model_invoked", "content_lifecycle_status", "approval_tier", "redistribution_authorized"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "transcript_artifact"},
    "artifact_id": {"type": "string", "pattern": "^transcript_[0-9a-f]{64}$"},
    "authorization_id": {"type": "string", "pattern": "^transauth_[0-9a-f]{64}$"},
    "authorization_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "request_id": {"type": "string", "pattern": "^transreq_[0-9a-f]{64}$"},
    "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "processing_plan_id": {"type": "string", "pattern": "^transplan_[0-9a-f]{64}$"},
    "processing_plan_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "media_run_id": {"type": "string", "pattern": "^mediarun_[0-9a-f]{64}$"},
    "media_asset_id": {"type": "string", "pattern": "^mediaasset_[0-9a-f]{64}$"},
    "media_payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_id": {"$ref": "common.schema.json#/$defs/sourceId"},
    "source_record_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "media_duration_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
    "segments": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "transcript-artifact.schema.json#/$defs/artifactSegment"}},
    "speaker_labels": {"type": "array", "minItems": 1, "maxItems": 99, "uniqueItems": true, "items": {"type": "string", "pattern": "^SPEAKER_[0-9]{2}$"}},
    "full_text": {"type": "string", "minLength": 1, "maxLength": 500000},
    "full_text_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generation_method": {"const": "LOCAL_DETERMINISTIC_FIXTURE_COPY"},
    "tool": {"$ref": "transcription-processing-plan-v2.schema.json#/$defs/tool"},
    "model": {"$ref": "transcription-processing-plan-v2.schema.json#/$defs/model"},
    "parameters": {"$ref": "transcription-processing-plan-v2.schema.json#/$defs/parameters"},
    "permissions_validated": {"type": "object", "additionalProperties": false, "required": ["transcript_generation", "timestamp_generation"], "properties": {"transcript_generation": {"const": true}, "timestamp_generation": {"const": true}}},
    "parent_media_read": {"const": false}, "media_transformed": {"const": false},
    "audio_extracted": {"const": false}, "external_process_invoked": {"const": false},
    "fixture_only": {"const": true}, "network_accessed": {"const": false},
    "provider_invoked": {"const": false}, "model_invoked": {"const": false},
    "content_lifecycle_status": {"const": "UNREVIEWED"}, "approval_tier": {"const": "MACHINE_VALIDATED"},
    "redistribution_authorized": {"const": false}
  }
}

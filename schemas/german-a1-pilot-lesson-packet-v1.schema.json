{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/german-a1-pilot-lesson-packet-v1.schema.json",
  "title": "English Master German A1 pilot lesson packet v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "packet_id", "language_code", "lesson_id", "tier", "sequence", "outline_targets", "prerequisite_lesson_ids", "title", "duration_minutes", "objectives", "sections", "exercises", "prompts", "content_status", "provenance", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "german_a1_pilot_lesson_packet"}, "packet_id": {"type": "string", "pattern": "^dea1pilot-packet-(0[1-9]|10)$"}, "language_code": {"const": "de"}, "lesson_id": {"type": "string", "pattern": "^de-a1-v1-u0[1-2]-l0[1-5]$"}, "tier": {"const": "A1.1"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 10}, "outline_targets": {"type": "array", "minItems": 1}, "prerequisite_lesson_ids": {"type": "array", "items": {"type": "string"}}, "title": {"type": "string", "minLength": 1}, "duration_minutes": {"type": "integer", "minimum": 15, "maximum": 45}, "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "sections": {"type": "array", "minItems": 2, "maxItems": 4}, "exercises": {"type": "array", "minItems": 3, "maxItems": 6}, "prompts": {"type": "array", "minItems": 4, "maxItems": 4}, "content_status": {"const": "UNREVIEWED"}, "provenance": {"type": "object", "additionalProperties": false, "required": ["content_origin", "content_input_id"], "properties": {"content_origin": {"const": "PROJECT_AUTHORED"}, "content_input_id": {"type": "string"}}}, "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

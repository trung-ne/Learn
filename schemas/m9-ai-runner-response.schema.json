{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m9-ai-runner-response.schema.json",
  "title": "English Master M9 provider-neutral AI runner response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "request_id", "provider", "model", "execution_id", "raw_response"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "m9_ai_runner_response"},
    "request_id": {"type": "string", "pattern": "^m9airunreq_[a-f0-9]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "raw_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "checklist", "findings", "limitations"],
      "properties": {
        "decision": {"enum": ["APPROVE", "NEEDS_REVISION", "REJECT"]},
        "checklist": {"type": "array", "minItems": 1, "items": {"$ref": "m9-ai-review-v2.schema.json#/$defs/check"}},
        "findings": {"type": "array", "items": {"$ref": "m9-ai-review-v2.schema.json#/$defs/finding"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

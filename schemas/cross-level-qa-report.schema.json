{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/cross-level-qa-report.schema.json",
  "title": "English Master cross-level A1-C2 deterministic QA report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "ruleset_version", "content_status", "request_sha256", "common_m15_population_sha256", "level_inputs", "lesson_count", "checks", "findings", "result", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "cross_level_qa_report"},
    "ruleset_version": {"const": "CROSS_LEVEL_QA_V1"},
    "content_status": {"const": "UNREVIEWED"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "common_m15_population_sha256": {"$ref": "#/$defs/sha256"},
    "level_inputs": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/level_input"}},
    "lesson_count": {"const": 300},
    "checks": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/check"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "result": {"enum": ["PASS", "FAIL"]},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "level_input": {"type": "object", "additionalProperties": false, "required": ["level", "run_id", "run_manifest_sha256", "packet_count"], "properties": {"level": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]}, "run_id": {"type": "string", "minLength": 3}, "run_manifest_sha256": {"$ref": "#/$defs/sha256"}, "packet_count": {"const": 50}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["code", "checked_count", "finding_count", "result"], "properties": {"code": {"type": "string", "pattern": "^CLQ_[A-Z0-9_]+$"}, "checked_count": {"type": "integer", "minimum": 0}, "finding_count": {"type": "integer", "minimum": 0}, "result": {"enum": ["PASS", "FLAG", "FAIL"]}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "lesson_id", "location", "message", "region_id"], "properties": {"code": {"type": "string", "pattern": "^CLQ_[A-Z0-9_]+$"}, "severity": {"enum": ["BLOCKING", "FLAG"]}, "lesson_id": {"type": ["string", "null"]}, "location": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 3}, "region_id": {"type": "string", "pattern": "^clq-region-[a-f0-9]{64}$"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/listening-transcription-fixture.schema.json",
  "title": "English Master M14 M13 Fixture Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "transcription_id",
    "payload_sha256",
    "fixture_only",
    "network_accessed",
    "media_accessed",
    "model_accessed",
    "verification",
    "transcript",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "listening_transcription_fixture"},
    "transcription_id": {"type": "string", "pattern": "^ldtx_[a-f0-9]{64}$"},
    "payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "fixture_only": {"const": true},
    "network_accessed": {"const": false},
    "media_accessed": {"const": false},
    "model_accessed": {"const": false},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "method", "transcription_run_id", "transcription_manifest_sha256", "transcription_verification_id", "transcription_verification_sha256", "transcript_artifact_id", "transcript_artifact_sha256", "media_schema_version", "media_run_id", "media_asset_id", "media_payload_sha256"],
      "properties": {
        "result": {"const": "PASS"},
        "method": {"const": "VERIFIED_M13_FIXTURE_PROJECTION"},
        "transcription_run_id": {"type": "string", "pattern": "^transrun_[a-f0-9]{64}$"},
        "transcription_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "transcription_verification_id": {"type": "string", "pattern": "^transverify_[a-f0-9]{64}$"},
        "transcription_verification_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "transcript_artifact_id": {"type": "string", "pattern": "^transcript_[a-f0-9]{64}$"},
        "transcript_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "media_schema_version": {"enum": ["1.0", "2.0"]},
        "media_run_id": {"type": "string", "pattern": "^mediarun_[a-f0-9]{64}$"},
        "media_asset_id": {"type": "string", "pattern": "^mediaasset_[a-f0-9]{64}$"},
        "media_payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "utterances"],
      "properties": {
        "language": {"const": "en"},
        "utterances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {"type": "string", "minLength": 1, "maxLength": 5000},
              "speaker_id": {"type": "string", "pattern": "^speaker_[a-z0-9]+(?:_[a-z0-9]+)*$"},
              "start_ms": {"type": "integer", "minimum": 0},
              "end_ms": {"type": "integer", "minimum": 1}
            },
            "dependentRequired": {
              "start_ms": ["end_ms"],
              "end_ms": ["start_ms"]
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}

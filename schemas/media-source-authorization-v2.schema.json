{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/media-source-authorization-v2.schema.json",
  "title": "English Master M12 Media Source Authorization v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "authorization_id", "authorization_mode", "fixture_only", "registry_path", "registry_sha256", "source_id", "source_status", "source_url", "source_record_id", "official_record_url", "media_kind", "expected_filename", "expected_payload_sha256", "expected_payload_bytes", "expected_mime_type", "expected_metadata", "license", "license_url", "attribution", "permissions", "permission_evidence", "authorized_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "media_source_authorization"},
    "authorization_id": {"type": "string", "pattern": "^mediaauth_[0-9a-f]{64}$"},
    "authorization_mode": {"const": "OFFLINE_TEST_FIXTURE_ONLY"},
    "fixture_only": {"const": true},
    "registry_path": {"type": "string", "minLength": 1, "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
    "registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_id": {"$ref": "common.schema.json#/$defs/sourceId"},
    "source_status": {"const": "APPROVED"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_record_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "official_record_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "media_kind": {"enum": ["AUDIO", "VIDEO"]},
    "expected_filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "expected_payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "expected_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "expected_mime_type": {"enum": ["audio/wav", "audio/mpeg", "audio/ogg", "video/mp4", "video/webm"]},
    "expected_metadata": {"$ref": "media-source-authorization.schema.json#/$defs/mediaMetadata"},
    "license": {"type": "string", "minLength": 1, "not": {"const": "UNKNOWN"}},
    "license_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "attribution": {"type": "string", "minLength": 1},
    "permissions": {"$ref": "#/$defs/permissions"},
    "permission_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/permissionEvidence"}},
    "authorized_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "operation": {"enum": ["can_download_audio", "can_download_video", "can_store", "can_clip", "can_transform", "can_extract_audio", "can_generate_transcript", "can_generate_timestamps", "can_redistribute"]},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["can_download_audio", "can_download_video", "can_store", "can_clip", "can_transform", "can_extract_audio", "can_generate_transcript", "can_generate_timestamps", "can_redistribute"],
      "properties": {
        "can_download_audio": {"type": "boolean"}, "can_download_video": {"type": "boolean"}, "can_store": {"type": "boolean"}, "can_clip": {"type": "boolean"}, "can_transform": {"type": "boolean"}, "can_extract_audio": {"type": "boolean"}, "can_generate_transcript": {"type": "boolean"}, "can_generate_timestamps": {"type": "boolean"}, "can_redistribute": {"type": "boolean"}
      }
    },
    "permissionEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "snapshot_path", "snapshot_sha256", "snapshot_bytes", "locator", "located_value_sha256", "evidence_note"],
      "properties": {
        "operation": {"$ref": "#/$defs/operation"},
        "snapshot_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$", "not": {"pattern": "(?:^|/)\\.\\.(?:/|$)|\\\\"}},
        "snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "snapshot_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "locator": {"$ref": "#/$defs/locator"},
        "located_value_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "locator": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "pointer"], "properties": {"kind": {"const": "JSON_POINTER"}, "pointer": {"type": "string", "pattern": "^(?:|/.*)$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "start_line", "end_line"], "properties": {"kind": {"const": "TEXT_LINE_RANGE"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}}}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/curriculum-approval-snapshot.schema.json",
  "title": "English Master M5 independent approval snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "snapshot_id", "status", "approval_scope", "manifest_id", "manifest_sha256", "reviewer_registry_id", "reviewer_registry_sha256", "curriculum_version", "taxonomy_version", "source_registry", "artifact_hashes", "approved_taxonomy_records", "reviewed_annotation_records", "reviews", "approved_at", "published_by", "source_bundle_policy"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "curriculum_approval_snapshot"},
    "snapshot_id": {"type": "string", "pattern": "^m5snapshot_[a-f0-9]{64}$"},
    "status": {"const": "APPROVED"},
    "approval_scope": {"const": "M5_ARCHITECTURE_REFERENCED_TAXONOMY_AND_REVIEWED_ANNOTATIONS"},
    "manifest_id": {"type": "string", "pattern": "^m5manifest_[a-f0-9]{64}$"},
    "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "reviewer_registry_id": {"type": "string", "pattern": "^m5reviewers_[a-f0-9]{64}$"},
    "reviewer_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "curriculum_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "taxonomy_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "source_registry": {"$ref": "curriculum-review-manifest.schema.json#/$defs/sourceRegistryBinding"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "graph", "coverage", "taxonomy"],
      "properties": {
        "structure": {"$ref": "common.schema.json#/$defs/sha256"},
        "graph": {"$ref": "common.schema.json#/$defs/sha256"},
        "coverage": {"$ref": "common.schema.json#/$defs/sha256"},
        "taxonomy": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "approved_taxonomy_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "curriculum-review-manifest.schema.json#/$defs/taxonomyRecord"}
    },
    "reviewed_annotation_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "curriculum-review-manifest.schema.json#/$defs/annotationRecord"}
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/reviewReference"}
    },
    "approved_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "published_by": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "source_bundle_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m5_records_remain_unchanged", "taxonomy_statuses_remain_draft", "lesson_outlines_remain_outline_only", "snapshot_contains_generated_lesson_content"],
      "properties": {
        "m5_records_remain_unchanged": {"const": true},
        "taxonomy_statuses_remain_draft": {"const": true},
        "lesson_outlines_remain_outline_only": {"const": true},
        "snapshot_contains_generated_lesson_content": {"const": false}
      }
    }
  },
  "$defs": {
    "reviewReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_role", "review_id", "reviewer_id", "identity_evidence_sha256", "sha256"],
      "properties": {
        "review_role": {"enum": ["LINGUISTIC", "PEDAGOGICAL"]},
        "review_id": {"type": "string", "pattern": "^m5review_[a-f0-9]{64}$"},
        "reviewer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$"},
        "identity_evidence_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}

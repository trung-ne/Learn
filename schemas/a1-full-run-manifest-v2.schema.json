{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/a1-full-run-manifest-v2.schema.json",
  "title": "English Master full A1 run manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "run_id", "built_at", "content_status", "source", "lesson_ids", "inventory", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "a1_full_run_manifest"},
    "run_id": {"type": "string", "pattern": "^a1full_[a-f0-9]{64}$"},
    "built_at": {"type": "string", "format": "date-time"},
    "content_status": {"const": "UNREVIEWED"},
    "source": {"type": "object", "additionalProperties": false, "required": ["population_sha256", "blueprint_sha256", "allocation_sha256", "content_manifest_sha256"], "properties": {"population_sha256": {"$ref": "#/$defs/sha256"}, "blueprint_sha256": {"$ref": "#/$defs/sha256"}, "allocation_sha256": {"$ref": "#/$defs/sha256"}, "content_manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "lesson_ids": {"type": "array", "minItems": 50, "maxItems": 50, "uniqueItems": true, "items": {"type": "string"}},
    "inventory": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^packets/a1full-packet-[0-9]{2}\\.json$"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

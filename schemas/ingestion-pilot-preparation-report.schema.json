{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://english-master.local/schemas/ingestion-pilot-preparation-report.schema.json","title":"English Master ingestion pilot preparation report","type":"object","additionalProperties":false,"required":["schema_version","record_type","report_id","authorization","receipt","source_id","official_payload_sha256","prepared_tsv_sha256","prepared_tsv_bytes","records_examined","records_selected","exclusions","selected_source_ids_sha256","outcome","content_lifecycle_status","approved_corpus","lesson_material","release_eligible"],"properties":{"schema_version":{"const":"1.0"},"record_type":{"const":"ingestion_pilot_preparation_report"},"report_id":{"type":"string","pattern":"^pilotprep_[a-f0-9]{64}$"},"authorization":{"$ref":"#/$defs/reference"},"receipt":{"$ref":"#/$defs/reference"},"source_id":{"const":"src_tatoeba_text"},"official_payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"prepared_tsv_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"prepared_tsv_bytes":{"type":"integer","minimum":1},"records_examined":{"type":"integer","minimum":0},"records_selected":{"type":"integer","minimum":1000,"maximum":5000},"exclusions":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"selected_source_ids_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"outcome":{"const":"PREPARED"},"content_lifecycle_status":{"const":"UNREVIEWED"},"approved_corpus":{"const":false},"lesson_material":{"const":false},"release_eligible":{"const":false}},"$defs":{"reference":{"type":"object","additionalProperties":false,"required":["id","sha256"],"properties":{"id":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-master.local/schemas/adaptive-review-state-v1.schema.json",
  "title":"English Master adaptive review state v1",
  "type":"array",
  "items":{"type":"object","additionalProperties":false,"required":["concept_id","interval_index","last_reviewed_at","last_mistake_at","next_review"],"properties":{"concept_id":{"type":"string","pattern":"^kg_[a-z0-9_]+$"},"interval_index":{"type":"integer","minimum":0,"maximum":5},"last_reviewed_at":{"$ref":"#/$defs/utc"},"last_mistake_at":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/utc"}]},"next_review":{"$ref":"#/$defs/utc"}}},
  "$defs":{"utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"}}
}

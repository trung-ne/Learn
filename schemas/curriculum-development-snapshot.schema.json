{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/curriculum-development-snapshot.schema.json",
  "title": "English Master M5 development approval snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "snapshot_id", "approval_tier", "authority_scope", "manifest_id", "manifest_sha256", "curriculum_version", "taxonomy_version", "source_registry", "artifact_hashes", "approved_taxonomy_records", "reviewed_annotation_records", "produced_at", "producing_tool", "source_bundle_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "curriculum_development_snapshot"},
    "snapshot_id": {"type": "string", "pattern": "^m5devsnapshot_[a-f0-9]{64}$"},
    "approval_tier": {"const": "DEVELOPMENT_APPROVED"},
    "authority_scope": {"const": "M5_DEVELOPMENT_ONLY"},
    "manifest_id": {"type": "string", "pattern": "^m5manifest_[a-f0-9]{64}$"},
    "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "curriculum_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "taxonomy_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "source_registry": {"$ref": "curriculum-review-manifest.schema.json#/$defs/sourceRegistryBinding"},
    "artifact_hashes": {
      "type": "object", "additionalProperties": false, "required": ["structure", "graph", "coverage", "taxonomy"],
      "properties": {
        "structure": {"$ref": "common.schema.json#/$defs/sha256"}, "graph": {"$ref": "common.schema.json#/$defs/sha256"},
        "coverage": {"$ref": "common.schema.json#/$defs/sha256"}, "taxonomy": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "approved_taxonomy_records": {"type": "array", "minItems": 1, "items": {"$ref": "curriculum-review-manifest.schema.json#/$defs/taxonomyRecord"}},
    "reviewed_annotation_records": {"type": "array", "minItems": 1, "items": {"$ref": "curriculum-review-manifest.schema.json#/$defs/annotationRecord"}},
    "produced_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "producing_tool": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "version": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "git_commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"}}},
    "source_bundle_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["m5_records_remain_unchanged", "taxonomy_statuses_remain_draft", "lesson_outlines_remain_outline_only", "snapshot_contains_generated_lesson_content", "not_human_reviewed", "not_release_approved"],
      "properties": {
        "m5_records_remain_unchanged": {"const": true}, "taxonomy_statuses_remain_draft": {"const": true},
        "lesson_outlines_remain_outline_only": {"const": true}, "snapshot_contains_generated_lesson_content": {"const": false},
        "not_human_reviewed": {"const": true}, "not_release_approved": {"const": true}
      }
    }
  }
}

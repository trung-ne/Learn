{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m9-ai-runner-request.schema.json",
  "title": "English Master M9 provider-neutral AI runner request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "request_id", "operation_index", "operation_count", "selection_id", "subject_id", "content_type", "review_role", "checklist", "prompt", "prompt_sha256", "config", "config_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "m9_ai_runner_request"},
    "request_id": {"type": "string", "pattern": "^m9airunreq_[a-f0-9]{64}$"},
    "operation_index": {"type": "integer", "minimum": 1},
    "operation_count": {"const": 120},
    "selection_id": {"type": "string", "pattern": "^m9select_[a-f0-9]{64}$"},
    "subject_id": {"type": "string", "pattern": "^m9sub_[a-f0-9]{64}$"},
    "content_type": {"enum": ["LESSON", "EXERCISE_SET", "AI_PRACTICE_PROMPT"]},
    "review_role": {"enum": ["LINGUISTIC_AI_REVIEWER", "PEDAGOGICAL_AI_REVIEWER"]},
    "checklist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prompt": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "config": {"type": ["object", "null"]},
    "config_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}

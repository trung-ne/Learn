{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/qa-engine-run-manifest.schema.json",
  "title": "English Master M8 terminal run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "run_manifest_id", "engine_run_id",
    "terminal_state", "request_sha256", "files", "terminal_at",
    "content_lifecycle_status", "human_reviewed", "release_approved",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "qa_engine_run_manifest"},
    "run_manifest_id": {"type": "string", "pattern": "^qaemanifest_[a-f0-9]{64}$"},
    "engine_run_id": {"type": "string", "pattern": "^qaerun_[a-f0-9]{64}$"},
    "terminal_state": {"enum": ["DEVELOPMENT_APPROVED", "REJECTED", "OPERATIONAL_FAILURE"]},
    "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string", "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*\\.json$"
          },
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "terminal_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "content_lifecycle_status": {"const": "UNREVIEWED"},
    "human_reviewed": {"const": false},
    "release_approved": {"const": false},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/qa-engine-stage-receipt.schema.json",
  "title": "English Master M8 stage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "receipt_id", "engine_run_id",
    "candidate_attempt_id", "candidate_sha256", "stage", "sequence",
    "result", "validator", "reviewer_type", "input_sha256", "checked_at",
    "issues", "review_reference", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "qa_engine_stage_receipt"},
    "receipt_id": {"type": "string", "pattern": "^qaereceipt_[a-f0-9]{64}$"},
    "engine_run_id": {"type": "string", "pattern": "^qaerun_[a-f0-9]{64}$"},
    "candidate_attempt_id": {"type": "string", "pattern": "^qaeattempt_[a-f0-9]{64}$"},
    "candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "stage": {"enum": ["SCHEMA", "ANSWER", "CEFR", "PREREQUISITE", "DUPLICATE", "LANGUAGE"]},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 6},
    "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "reviewer_type": {"enum": ["MACHINE", "AI"]},
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "checked_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "review_reference": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["evidence_kind", "review_id", "review_sha256"],
          "properties": {
            "evidence_kind": {"enum": ["M8_CANDIDATE_BOUND", "M7_BOUND_LEGACY"]},
            "review_id": {"type": "string", "pattern": "^qaeaireview_[a-f0-9]{64}$"},
            "review_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      ]
    },
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    }
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "SCHEMA"}}}, "then": {"properties": {"sequence": {"const": 1}, "reviewer_type": {"const": "MACHINE"}, "review_reference": {"type": "null"}}}},
    {"if": {"properties": {"stage": {"const": "ANSWER"}}}, "then": {"properties": {"sequence": {"const": 2}, "reviewer_type": {"const": "MACHINE"}, "review_reference": {"type": "null"}}}},
    {"if": {"properties": {"stage": {"const": "CEFR"}}}, "then": {"properties": {"sequence": {"const": 3}, "reviewer_type": {"const": "MACHINE"}, "review_reference": {"type": "null"}}}},
    {"if": {"properties": {"stage": {"const": "PREREQUISITE"}}}, "then": {"properties": {"sequence": {"const": 4}, "reviewer_type": {"const": "MACHINE"}, "review_reference": {"type": "null"}}}},
    {"if": {"properties": {"stage": {"const": "DUPLICATE"}}}, "then": {"properties": {"sequence": {"const": 5}, "reviewer_type": {"const": "MACHINE"}, "review_reference": {"type": "null"}}}},
    {"if": {"properties": {"stage": {"const": "LANGUAGE"}}}, "then": {"properties": {"sequence": {"const": 6}, "reviewer_type": {"const": "AI"}}}},
    {"if": {"properties": {"result": {"enum": ["FAIL", "ERROR"]}}}, "then": {"properties": {"issues": {"minItems": 1}}}},
    {"if": {"properties": {"stage": {"const": "LANGUAGE"}, "result": {"enum": ["PASS", "FAIL"]}}}, "then": {"properties": {"review_reference": {"type": "object"}}}},
    {"if": {"properties": {"result": {"enum": ["NOT_RUN", "ERROR"]}}}, "then": {"properties": {"review_reference": {"type": "null"}}}}
  ],
  "$defs": {
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "severity": {"enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]}
      }
    }
  }
}

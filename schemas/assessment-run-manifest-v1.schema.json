{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/assessment-run-manifest-v1.schema.json",
  "title": "English Master assessment run manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "run_id", "policy_version", "content_status", "request_sha256", "common_m15_population_sha256", "source_inputs", "counts", "package_inventory", "limitations", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "assessment_run_manifest"},
    "run_id": {"type": "string", "pattern": "^assessment_[a-f0-9]{64}$"},
    "policy_version": {"const": "ASSESSMENT_MASTERY_V1"}, "content_status": {"const": "UNREVIEWED"},
    "request_sha256": {"$ref": "#/$defs/sha256"}, "common_m15_population_sha256": {"$ref": "#/$defs/sha256"},
    "source_inputs": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [{"$ref": "#/$defs/a1"}, {"$ref": "#/$defs/a2"}, {"$ref": "#/$defs/b1"}, {"$ref": "#/$defs/b2"}, {"$ref": "#/$defs/c1"}, {"$ref": "#/$defs/c2"}], "items": false},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["lesson_quizzes", "unit_tests", "level_tests", "placement_packages", "packages"],
      "properties": {"lesson_quizzes": {"const": 300}, "unit_tests": {"const": 60}, "level_tests": {"const": 6}, "placement_packages": {"const": 1}, "packages": {"const": 367}}
    },
    "package_inventory": {
      "type": "array", "minItems": 367, "maxItems": 367, "uniqueItems": true,
      "items": {"$ref": "#/$defs/packageEntry"},
      "allOf": [
        {"contains": {"properties": {"assessment_type": {"const": "LESSON_QUIZ"}}}, "minContains": 300, "maxContains": 300},
        {"contains": {"properties": {"assessment_type": {"const": "UNIT_TEST"}}}, "minContains": 60, "maxContains": 60},
        {"contains": {"properties": {"assessment_type": {"const": "LEVEL_TEST"}}}, "minContains": 6, "maxContains": 6},
        {"contains": {"properties": {"assessment_type": {"const": "PLACEMENT"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "limitations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["level", "run_id", "run_manifest_sha256", "blueprint_sha256", "packet_count"], "properties": {"level": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]}, "run_id": {"type": "string", "minLength": 1}, "run_manifest_sha256": {"$ref": "#/$defs/sha256"}, "blueprint_sha256": {"$ref": "#/$defs/sha256"}, "packet_count": {"const": 50}}},
    "a1": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"level": {"const": "A1"}}}]}, "a2": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"level": {"const": "A2"}}}]}, "b1": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"level": {"const": "B1"}}}]}, "b2": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"level": {"const": "B2"}}}]}, "c1": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"level": {"const": "C1"}}}]}, "c2": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"level": {"const": "C2"}}}]},
    "packageEntry": {"type": "object", "additionalProperties": false, "required": ["assessment_id", "assessment_type", "path", "package_sha256", "item_count"], "properties": {"assessment_id": {"type": "string", "pattern": "^(lesson-quiz|unit-test|level-test|placement)-[a-z0-9._-]+$"}, "assessment_type": {"enum": ["LESSON_QUIZ", "UNIT_TEST", "LEVEL_TEST", "PLACEMENT"]}, "path": {"type": "string", "pattern": "^packages/[a-z0-9._-]+\\.json$"}, "package_sha256": {"$ref": "#/$defs/sha256"}, "item_count": {"type": "integer", "minimum": 1}}}
  }
}

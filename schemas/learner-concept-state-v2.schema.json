{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/learner-concept-state-v2.schema.json",
  "title": "English Master language-bound local learner concept state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "language_code", "concepts"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "learner_concept_state"},
    "language_code": {"$ref": "#/$defs/supportedLanguageCode"},
    "concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/conceptState"}
    }
  },
  "$defs": {
    "supportedLanguageCode": {"type": "string", "enum": ["en", "de"]},
    "conceptState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "attempts", "correct", "incorrect", "mastery", "last_seen", "next_review"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^kg_(en|de)_[a-z0-9_]+$"},
        "attempts": {"type": "integer", "minimum": 1},
        "correct": {"type": "integer", "minimum": 0},
        "incorrect": {"type": "integer", "minimum": 0},
        "mastery": {"type": "number", "minimum": 0, "maximum": 1},
        "last_seen": {"$ref": "#/$defs/utcDateTime"},
        "next_review": {"$ref": "#/$defs/utcDateTime"}
      }
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}

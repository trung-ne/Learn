{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/a2-pilot-lesson-packet.schema.json",
  "title": "English Master A2 pilot lesson packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "packet_id", "lesson_id", "tier", "sequence", "outline_targets", "prerequisite_lesson_ids", "title", "duration_minutes", "objectives", "content_sections", "exercises", "prompts", "content_status", "provenance", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "a2_pilot_lesson_packet"},
    "packet_id": {"type": "string", "pattern": "^a2pilot-packet-[0-9]{2}$"},
    "lesson_id": {"type": "string", "minLength": 1},
    "tier": {"const": "A2.1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 10},
    "outline_targets": {"type": "array", "minItems": 1},
    "prerequisite_lesson_ids": {"type": "array", "items": {"type": "string"}},
    "title": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "minimum": 15, "maximum": 45},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "content_sections": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "exercises": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "prompts": {"type": "object", "additionalProperties": false, "required": ["listening", "speaking", "pronunciation", "writing"], "properties": {"listening": {"type": "object"}, "speaking": {"type": "object"}, "pronunciation": {"type": "object"}, "writing": {"type": "object"}}},
    "content_status": {"const": "UNREVIEWED"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["content_origin", "content_input_id"], "properties": {"content_origin": {"const": "PROJECT_AUTHORED"}, "content_input_id": {"type": "string"}}},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

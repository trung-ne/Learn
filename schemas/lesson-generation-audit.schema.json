{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/lesson-generation-audit.schema.json",
  "title": "English Master M6 snapshot-bound lesson generation audit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "request_id", "lesson_id", "status", "validation_stage", "snapshot_binding", "input_hashes", "versions", "constraints_applied", "response_provenance", "checks", "output_hash", "qa_status", "qa_reviewer", "qa_timestamp", "qa_outcome", "qa_checks_performed", "qa_notes", "qa_issues_found", "outstanding_independent_reviews", "unresolved_issues", "reproducibility"],
  "properties": {
    "schema_version": {"const": "2.0"}, "record_type": {"const": "lesson_generation_audit"},
    "request_id": {"type": "string", "pattern": "^(req_[a-f0-9]{64}|UNAVAILABLE)$"}, "lesson_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/lessonId"}, {"const": "UNAVAILABLE"}]},
    "status": {"enum": ["ACCEPTED", "REJECTED"]}, "validation_stage": {"enum": ["PREFLIGHT", "PROVIDER", "POSTVALIDATION", "PUBLICATION", "COMPLETE"]},
    "snapshot_binding": {"$ref": "lesson-generation-authorization.schema.json#/$defs/snapshotBinding"},
    "input_hashes": {"$ref": "#/$defs/inputHashes"}, "versions": {"$ref": "#/$defs/versions"}, "constraints_applied": {"type": "object"},
    "response_provenance": {"anyOf": [{"$ref": "#/$defs/responseProvenance"}, {"type": "null"}]}, "checks": {"$ref": "#/$defs/checks"},
    "output_hash": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}, "qa_status": {"enum": ["UNREVIEWED", "REJECTED"]},
    "qa_reviewer": {"const": "english_master.m6_automated_validator"}, "qa_timestamp": {"$ref": "common.schema.json#/$defs/isoDateTime"},
    "qa_outcome": {"enum": ["AUTOMATED_CHECKS_PASSED_PENDING_INDEPENDENT_REVIEW", "AUTOMATED_CHECKS_FAILED"]}, "qa_checks_performed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "qa_notes": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "qa_issues_found": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "outstanding_independent_reviews": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["CEFR", "GRAMMAR_LEXICAL", "LANGUAGE_QUALITY", "PEDAGOGICAL"]}},
    "unresolved_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "reproducibility": {"$ref": "#/$defs/reproducibility"}
  },
  "$defs": {
    "checkOutcome": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "issue": {"type": "object", "additionalProperties": false, "required": ["code", "path", "message"], "properties": {"code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}, "path": {"type": "string"}, "message": {"type": "string", "minLength": 1}}},
    "inputHashes": {"type": "object", "additionalProperties": false, "required": ["request", "authorization", "structure", "graph", "coverage", "taxonomy", "source_registry"], "properties": {"request": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}, "authorization": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}, "structure": {"$ref": "common.schema.json#/$defs/sha256"}, "graph": {"$ref": "common.schema.json#/$defs/sha256"}, "coverage": {"$ref": "common.schema.json#/$defs/sha256"}, "taxonomy": {"$ref": "common.schema.json#/$defs/sha256"}, "source_registry": {"$ref": "common.schema.json#/$defs/sha256"}}},
    "versions": {"type": "object", "additionalProperties": false, "required": ["generator", "prompt", "curriculum", "taxonomy", "lesson_schema"], "properties": {"generator": {"type": "string"}, "prompt": {"type": "string"}, "curriculum": {"type": "string"}, "taxonomy": {"type": "string"}, "lesson_schema": {"type": "string"}}},
    "responseProvenance": {"type": "object", "additionalProperties": false, "required": ["prompt_sha256", "response_sha256", "provider", "model", "parameters", "seed", "observed_at", "deterministic", "replayable_from_capture"], "properties": {"prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "response_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "parameters": {"type": "object"}, "seed": {"type": ["integer", "null"]}, "observed_at": {"$ref": "common.schema.json#/$defs/isoDateTime"}, "deterministic": {"type": "boolean"}, "replayable_from_capture": {"type": "boolean"}}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["request_schema", "m5_authority", "authorization", "identity", "graph", "constraints", "provenance_copyright", "backend_contract", "lesson_schema", "cefr_reference_scope", "prerequisites", "m7_plus_exclusion", "publication"], "properties": {"request_schema": {"$ref": "#/$defs/checkOutcome"}, "m5_authority": {"$ref": "#/$defs/checkOutcome"}, "authorization": {"$ref": "#/$defs/checkOutcome"}, "identity": {"$ref": "#/$defs/checkOutcome"}, "graph": {"$ref": "#/$defs/checkOutcome"}, "constraints": {"$ref": "#/$defs/checkOutcome"}, "provenance_copyright": {"$ref": "#/$defs/checkOutcome"}, "backend_contract": {"$ref": "#/$defs/checkOutcome"}, "lesson_schema": {"$ref": "#/$defs/checkOutcome"}, "cefr_reference_scope": {"$ref": "#/$defs/checkOutcome"}, "prerequisites": {"$ref": "#/$defs/checkOutcome"}, "m7_plus_exclusion": {"$ref": "#/$defs/checkOutcome"}, "publication": {"$ref": "#/$defs/checkOutcome"}}},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["canonical_json", "byte_identical_claimed", "backend_deterministic", "seeded", "replayable_from_capture"], "properties": {"canonical_json": {"const": true}, "byte_identical_claimed": {"type": "boolean"}, "backend_deterministic": {"type": "boolean"}, "seeded": {"type": "boolean"}, "replayable_from_capture": {"type": "boolean"}}}
  }
}

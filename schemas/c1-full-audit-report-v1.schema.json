{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/c1-full-audit-report-v1.schema.json",
  "title": "English Master full C1 deterministic audit report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "run_id", "manifest_sha256", "ruleset_version", "lesson_count", "checks", "findings", "result", "limitations", "report_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "c1_full_audit_report"},
    "run_id": {"type": "string", "pattern": "^c1full_[a-f0-9]{64}$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "ruleset_version": {"const": "C1_FULL_LIGHTWEIGHT_V2"},
    "lesson_count": {"const": 50},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code", "checked_count", "finding_count", "result"], "properties": {"code": {"type": "string", "pattern": "^C1F_[A-Z0-9_]+$"}, "checked_count": {"type": "integer", "minimum": 0}, "finding_count": {"type": "integer", "minimum": 0}, "result": {"enum": ["PASS", "FAIL"]}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "lesson_id", "location", "message"], "properties": {"code": {"type": "string", "pattern": "^C1F_[A-Z0-9_]+$"}, "lesson_id": {"type": ["string", "null"]}, "location": {"type": "string"}, "message": {"type": "string", "minLength": 3}}}},
    "result": {"enum": ["PASS", "FAIL"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

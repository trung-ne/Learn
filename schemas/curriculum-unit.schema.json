{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/curriculum-unit.schema.json",
  "title": "English Master M5 curriculum unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "global_unit_number", "level", "tier", "title", "theme", "goals", "lesson_ids", "review_node_id", "prerequisite_units", "skills", "dimensions", "estimated_hours", "status"],
  "properties": {
    "id": {"$ref": "curriculum-common.schema.json#/$defs/unitId"},
    "global_unit_number": {"type": "integer", "minimum": 1, "maximum": 99},
    "level": {"$ref": "curriculum-common.schema.json#/$defs/officialCefr"},
    "tier": {"$ref": "curriculum-common.schema.json#/$defs/internalTier"},
    "title": {"$ref": "curriculum-common.schema.json#/$defs/outlineText"},
    "theme": {"$ref": "curriculum-common.schema.json#/$defs/outlineText"},
    "goals": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "curriculum-common.schema.json#/$defs/outlineText"}},
    "lesson_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "curriculum-common.schema.json#/$defs/lessonId"}},
    "review_node_id": {"$ref": "curriculum-common.schema.json#/$defs/reviewId"},
    "prerequisite_units": {"type": "array", "uniqueItems": true, "items": {"$ref": "curriculum-common.schema.json#/$defs/unitId"}},
    "skills": {"$ref": "curriculum-common.schema.json#/$defs/skills"},
    "dimensions": {"$ref": "curriculum-common.schema.json#/$defs/dimensions"},
    "estimated_hours": {
      "type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "basis"],
      "properties": {"minimum": {"type": "number", "exclusiveMinimum": 0}, "maximum": {"type": "number", "exclusiveMinimum": 0}, "basis": {"const": "PLANNING_ESTIMATE"}}
    },
    "status": {"$ref": "curriculum-common.schema.json#/$defs/outlineStatus"}
  }
}

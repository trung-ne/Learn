{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m9-human-review.schema.json",
  "title": "English Master M9 optional human review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "review_id", "development_batch_id", "development_batch_sha256", "reviewer", "review_role", "independence", "decision", "checklist", "findings", "reviewed_at", "human_reviewed", "release_approved"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "m9_human_review"}, "review_id": {"type": "string", "pattern": "^m9humanreview_[a-f0-9]{64}$"}, "development_batch_id": {"type": "string", "pattern": "^m9devbatch_[a-f0-9]{64}$"}, "development_batch_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "reviewer": {"$ref": "#/$defs/reviewer"}, "review_role": {"enum": ["LINGUISTIC", "PEDAGOGICAL"]}, "independence": {"$ref": "#/$defs/independence"}, "decision": {"enum": ["APPROVE", "NEEDS_REVISION", "REJECT"]}, "checklist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "reviewed_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"}, "human_reviewed": {"const": false}, "release_approved": {"const": false}
  },
  "$defs": {
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "display_name", "qualifications", "identity_evidence_id"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}, "qualifications": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "identity_evidence_id": {"type": "string", "minLength": 1}}},
    "independence": {"type": "object", "additionalProperties": false, "required": ["independent_of_generation", "conflict_declared"], "properties": {"independent_of_generation": {"const": true}, "conflict_declared": {"const": true}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["criterion", "result", "notes"], "properties": {"criterion": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}, "notes": {"type": "string", "minLength": 1}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["severity", "category", "description"], "properties": {"severity": {"enum": ["MINOR", "MAJOR", "CRITICAL"]}, "category": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "recommendation": {"type": "string"}}}
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-master.local/schemas/adaptive-review-plan-v1.schema.json",
  "title":"English Master adaptive review plan v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","record_type","policy_version","assessment_run_id","manifest_sha256","state_sha256","adaptive_state_sha256","lesson_id","as_of","limit","entries","plan_sha256"],
  "properties":{"schema_version":{"const":"1.0"},"record_type":{"const":"adaptive_review_plan"},"policy_version":{"const":"ADAPTIVE_REVIEW_V1"},"assessment_run_id":{"type":"string"},"manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"state_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"adaptive_state_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"lesson_id":{"type":"string"},"as_of":{"$ref":"#/$defs/utc"},"limit":{"type":"integer","minimum":1,"maximum":100},"entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["concept_id","reasons","item_id","item_sha256","assessment_id","package_sha256","source_lesson_id"],"properties":{"concept_id":{"type":"string","pattern":"^kg_[a-z0-9_]+$"},"reasons":{"type":"array","items":{"enum":["NEW_LESSON","RECENT_MISTAKE","DUE","OLD_WEAK"]},"minItems":1,"uniqueItems":true},"item_id":{"type":"string"},"item_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"assessment_id":{"type":"string"},"package_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_lesson_id":{"type":"string"}}}},"plan_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "$defs":{"utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]Z$"}}
}

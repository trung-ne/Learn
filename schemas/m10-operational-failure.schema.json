{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://english-master.local/schemas/m10-operational-failure.schema.json", "title": "English Master M10 operational failure", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "failure_id", "run_id", "stage", "error_code", "message", "failed_at", "content_lifecycle_status", "development_approved", "human_reviewed", "release_approved", "provider_authenticated"],
  "properties": {"schema_version": {"const": "1.0"}, "record_type": {"const": "m10_operational_failure"}, "failure_id": {"type": "string", "pattern": "^m10failure_[a-f0-9]{64}$"}, "run_id": {"type": "string", "pattern": "^m10run_[a-f0-9]{64}$"}, "attempt_id": {"type": "string", "pattern": "^m10attempt_[a-f0-9]{64}$"}, "stage": {"enum": ["CAPTURE_INTEGRITY", "SUCCESSOR_SCHEMA", "AUTHORITY_BINDING", "REPAIR_SCOPE", "DEPENDENCY_REBUILD", "CLOSED_INVENTORY", "PUBLICATION"]}, "error_code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "failed_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"}, "content_lifecycle_status": {"const": "UNREVIEWED"}, "development_approved": {"const": false}, "human_reviewed": {"const": false}, "release_approved": {"const": false}, "provider_authenticated": {"const": false}}
}

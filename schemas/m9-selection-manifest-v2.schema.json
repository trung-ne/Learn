{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m9-selection-manifest-v2.schema.json",
  "title": "English Master active M9 full-population selection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "selection_id", "selection_policy", "selection_scope", "rationale", "upstream", "population", "subjects", "created_at", "content_lifecycle_status"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "m9_selection_manifest"},
    "selection_id": {"type": "string", "pattern": "^m9select_[a-f0-9]{64}$"},
    "selection_policy": {"const": "M9_FULL_POPULATION_V2"},
    "selection_scope": {"const": "FULL_POPULATION"},
    "rationale": {"type": "string", "minLength": 1},
    "upstream": {"$ref": "#/$defs/upstream"},
    "population": {"$ref": "#/$defs/population"},
    "subjects": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"$ref": "#/$defs/subject"}, "uniqueItems": true},
    "created_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "content_lifecycle_status": {"const": "UNREVIEWED"}
  },
  "$defs": {
    "sha": {"$ref": "common.schema.json#/$defs/sha256"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m5_snapshot_binding", "m6_batch_id", "m6_batch_sha256", "m7_batch_id", "m7_batch_sha256", "m8_2_pilot_id", "m8_2_pilot_sha256", "m8_1_terminal_run_consumed"],
      "properties": {
        "m5_snapshot_binding": {"type": "object"},
        "m6_batch_id": {"type": "string", "minLength": 1},
        "m6_batch_sha256": {"$ref": "#/$defs/sha"},
        "m7_batch_id": {"type": "string", "minLength": 1},
        "m7_batch_sha256": {"$ref": "#/$defs/sha"},
        "m8_2_pilot_id": {"type": "string", "minLength": 1},
        "m8_2_pilot_sha256": {"$ref": "#/$defs/sha"},
        "m8_1_terminal_run_consumed": {"const": false}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_count", "exercise_set_count", "prompt_count", "total_subject_count", "selected_subject_count", "unreviewed_outside_selection"],
      "properties": {
        "lesson_count": {"const": 10},
        "exercise_set_count": {"const": 10},
        "prompt_count": {"const": 40},
        "total_subject_count": {"const": 60},
        "selected_subject_count": {"const": 60},
        "unreviewed_outside_selection": {"const": false}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "content_type", "lesson_id", "artifact_path", "artifact_sha256", "machine_audit_path", "machine_audit_sha256"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^m9sub_[a-f0-9]{64}$"},
        "content_type": {"enum": ["LESSON", "EXERCISE_SET", "AI_PRACTICE_PROMPT"]},
        "lesson_id": {"$ref": "common.schema.json#/$defs/lessonId"},
        "modality": {"enum": ["LISTENING", "SPEAKING", "PRONUNCIATION", "WRITING"]},
        "artifact_path": {"$ref": "#/$defs/safePath"},
        "artifact_sha256": {"$ref": "#/$defs/sha"},
        "machine_audit_path": {"$ref": "#/$defs/safePath"},
        "machine_audit_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}

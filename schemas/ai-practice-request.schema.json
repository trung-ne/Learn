{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/ai-practice-request.schema.json",
  "title": "English Master M8.2 lesson-bound AI practice request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "authorization_id",
    "authorization_sha256",
    "lesson_id",
    "lesson_sha256",
    "lesson_audit_sha256",
    "cefr_level",
    "modality",
    "objectives",
    "known_vocabulary",
    "target_vocabulary",
    "review_vocabulary",
    "known_grammar",
    "target_grammar",
    "review_grammar",
    "known_functions",
    "target_functions",
    "review_functions",
    "known_pronunciation",
    "target_pronunciation",
    "review_pronunciation",
    "prerequisite_context",
    "taxonomy_context",
    "source_section_ids",
    "scope_types",
    "prompt_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "ai_practice_request"
    },
    "request_id": {
      "type": "string",
      "pattern": "^aipreq_[a-f0-9]{64}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^aipauth_[a-f0-9]{64}$"
    },
    "authorization_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "lesson_id": {
      "$ref": "common.schema.json#/$defs/lessonId"
    },
    "lesson_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "lesson_audit_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "cefr_level": {
      "$ref": "common.schema.json#/$defs/cefrLevel"
    },
    "modality": {
      "enum": [
        "LISTENING",
        "SPEAKING",
        "PRONUNCIATION",
        "WRITING"
      ]
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_vocabulary": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/vocabularySenseId"
      },
      "uniqueItems": true
    },
    "target_vocabulary": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/vocabularySenseId"
      },
      "uniqueItems": true
    },
    "review_vocabulary": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/vocabularySenseId"
      },
      "uniqueItems": true
    },
    "known_grammar": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "target_grammar": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "review_grammar": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "known_functions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "target_functions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "review_functions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "known_pronunciation": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "target_pronunciation": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "review_pronunciation": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "prerequisite_context": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/lessonId"
      },
      "uniqueItems": true
    },
    "taxonomy_context": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "source_section_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^section_[a-z0-9_]+$"
      },
      "uniqueItems": true
    },
    "scope_types": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_grammar",
        "target_functions",
        "target_pronunciation"
      ],
      "properties": {
        "target_grammar": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/conceptId"
          },
          "uniqueItems": true
        },
        "target_functions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/conceptId"
          },
          "uniqueItems": true
        },
        "target_pronunciation": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/conceptId"
          },
          "uniqueItems": true
        }
      }
    },
    "prompt_version": {
      "enum": [
        "M8_2_AI_PRACTICE_v9",
        "M8_2_AI_PRACTICE_v10"
      ]
    }
  }
}

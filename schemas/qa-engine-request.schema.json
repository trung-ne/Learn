{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://english-master.local/schemas/qa-engine-request.schema.json","title":"English Master M8 QA engine request","type":"object","additionalProperties":false,"required":["schema_version","record_type","engine_run_id","m7_batch_id","exercise_set_id","exercise_set_sha256","audit_sha256","lesson_id","maximum_attempts","stages","policy_version","created_at"],"properties":{"schema_version":{"const":"1.0"},"record_type":{"const":"qa_engine_request"},"engine_run_id":{"type":"string","pattern":"^qaerun_[a-f0-9]{64}$"},"m7_batch_id":{"type":"string","pattern":"^m7devbatch_[a-f0-9]{64}$"},"exercise_set_id":{"type":"string","pattern":"^m7set_[a-f0-9]{64}$"},"exercise_set_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"audit_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"lesson_id":{"$ref":"common.schema.json#/$defs/lessonId"},"maximum_attempts":{"type":"integer","minimum":1,"maximum":3},"stages":{"const":["SCHEMA","ANSWER","CEFR","PREREQUISITE","DUPLICATE","LANGUAGE"]},"policy_version":{"type":"string","minLength":1,"maxLength":100},"created_at":{"$ref":"common.schema.json#/$defs/orderableDateTime"}}}
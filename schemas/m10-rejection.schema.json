{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://english-master.local/schemas/m10-rejection.schema.json", "title": "English Master M10 immutable candidate rejection", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "rejection_id", "run_id", "attempt", "rejected_content_sha256", "receipt_hashes", "blocking_issues", "repair_constraints", "retryable", "remaining_attempts", "rejected_at", "content_lifecycle_status", "development_approved", "provider_authenticated"],
  "properties": {"schema_version": {"const": "1.0"}, "record_type": {"const": "m10_rejection"}, "rejection_id": {"type": "string", "pattern": "^m10reject_[a-f0-9]{64}$"}, "run_id": {"type": "string", "pattern": "^m10run_[a-f0-9]{64}$"}, "attempt": {"$ref": "#/$defs/reference"}, "rejected_content_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "receipt_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/sha256"}}, "blocking_issues": {"type": "array", "minItems": 1, "items": {"$ref": "m10-verification-receipt.schema.json#/$defs/issue"}}, "repair_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "repair_constraints_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "retryable": {"type": "boolean"}, "remaining_attempts": {"type": "integer", "minimum": 0, "maximum": 2}, "rejected_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"}, "content_lifecycle_status": {"const": "UNREVIEWED"}, "development_approved": {"const": false}, "provider_authenticated": {"const": false}},
  "$defs": {"reference": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "pattern": "^m10attempt_[a-f0-9]{64}$"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}}}
}

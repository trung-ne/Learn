{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m10-regeneration-capture.schema.json",
  "title": "English Master M10 regeneration capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "capture_id", "run_id", "attempt_number", "prompt_sha256", "raw_response_sha256", "capture_mode", "provider", "model", "execution_id", "parameters", "provider_authenticated", "captured_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "m10_regeneration_capture"},
    "capture_id": {"type": "string", "pattern": "^m10capture_[a-f0-9]{64}$"}, "run_id": {"type": "string", "pattern": "^m10run_[a-f0-9]{64}$"}, "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3},
    "prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "raw_response_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "capture_mode": {"enum": ["SESSION_CAPTURED", "PROVIDER_CAPTURED", "TEST_ONLY", "REPLAY_ONLY"]},
    "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "execution_id": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}, "seed": {"type": ["integer", "null"]}, "provider_authenticated": {"const": false}, "captured_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/german-a1-pilot-content-input-v1.schema.json",
  "title": "English Master German A1 pilot authored content input v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "edition", "language_code", "content_status", "authorship", "external_materials", "media", "lessons"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "german_a1_pilot_content_input"},
    "edition": {"const": "de-a1-v1"}, "language_code": {"const": "de"},
    "content_status": {"const": "UNREVIEWED"}, "authorship": {"const": "PROJECT_AUTHORED"},
    "external_materials": {"type": "array", "maxItems": 0}, "media": {"type": "array", "maxItems": 0},
    "lessons": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/lesson"}}
  },
  "$defs": {
    "section": {"type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": {"title": {"type": "string", "minLength": 1}, "body": {"type": "string", "minLength": 1}}},
    "exercise": {"type": "object", "additionalProperties": false, "required": ["id", "type", "prompt"], "properties": {"id": {"type": "string", "pattern": "^ex-[1-4]$"}, "type": {"type": "string", "enum": ["selection", "completion", "ordering", "matching", "writing"]}, "prompt": {"type": "string", "minLength": 1}, "answer": {"type": "string", "minLength": 1}, "rubric": {"type": "string", "minLength": 1}}},
    "prompt": {"type": "object", "additionalProperties": false, "required": ["modality", "instruction"], "properties": {"modality": {"type": "string", "enum": ["listening", "speaking", "pronunciation", "writing"]}, "instruction": {"type": "string", "minLength": 1}, "mode": {"type": "string"}, "transcript": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "answer": {"type": "string", "minLength": 1}, "assessment": {"type": "string"}, "checklist": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "lesson": {"type": "object", "additionalProperties": false, "required": ["outline_id", "title", "duration_minutes", "objectives", "sections", "exercises", "prompts"], "properties": {"outline_id": {"type": "string", "pattern": "^de-a1-v1-u0[1-2]-l0[1-5]$"}, "title": {"type": "string", "minLength": 1}, "duration_minutes": {"type": "integer", "minimum": 15, "maximum": 45}, "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "sections": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/section"}}, "exercises": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/exercise"}}, "prompts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/prompt"}}}}
  }
}

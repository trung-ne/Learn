{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://english-master.local/schemas/ingestion-pilot-authorization.schema.json","title":"English Master ingestion pilot authorization","type":"object","additionalProperties":false,"required":["schema_version","record_type","authorization_id","status","source_id","registry_sha256","official_download_url","official_documentation_url","expected_filename","expected_payload_sha256","expected_payload_bytes","checksum_origin","target_records","language","license","license_url","authorized_operations","authorized_by","authorized_at","content_lifecycle_status","approved_corpus","lesson_material","release_eligible"],"properties":{"schema_version":{"const":"1.0"},"record_type":{"const":"ingestion_pilot_authorization"},"authorization_id":{"type":"string","pattern":"^pilotauth_[a-f0-9]{64}$"},"status":{"const":"AUTHORIZED"},"source_id":{"const":"src_tatoeba_text"},"registry_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"official_download_url":{"type":"string","format":"uri"},"official_documentation_url":{"type":"string","format":"uri"},"expected_filename":{"type":"string","pattern":"^[^/\\\\]+$","minLength":1},"expected_payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"expected_payload_bytes":{"type":"integer","minimum":1},"checksum_origin":{"enum":["OFFICIAL_PUBLISHED","LOCALLY_OBSERVED"]},"target_records":{"type":"integer","minimum":1000,"maximum":5000},"language":{"const":"eng"},"license":{"type":"string","minLength":1},"license_url":{"type":"string","format":"uri"},"authorized_operations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"authorized_by":{"type":"string","minLength":1},"authorized_at":{"$ref":"common.schema.json#/$defs/orderableDateTime"},"content_lifecycle_status":{"const":"UNREVIEWED"},"approved_corpus":{"const":false},"lesson_material":{"const":false},"release_eligible":{"const":false}}}
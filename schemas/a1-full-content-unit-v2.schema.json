{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/a1-full-content-unit-v2.schema.json",
  "title": "English Master full A1 authored unit v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "unit_id", "tier", "content_origin", "lessons"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "a1_full_content_unit"},
    "unit_id": {"type": "string", "pattern": "^m16a1-v1-a1-u[0-9]{2}$"},
    "tier": {"enum": ["A1.1", "A1.2"]},
    "content_origin": {"const": "PROJECT_AUTHORED"},
    "lessons": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/lesson"}}
  },
  "$defs": {
    "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^a1t_u[0-9]{2}_[a-z0-9_]+$"}},
    "constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
    "lesson": {
      "type": "object", "additionalProperties": false,
      "required": ["lesson_id", "title", "duration_minutes", "objective_target_ids", "objectives", "content_sections", "exercises", "practice"],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^m16a1-v1-a1-u[0-9]{2}-l[0-9]{2}$"},
        "title": {"type": "string", "minLength": 3},
        "duration_minutes": {"type": "integer", "minimum": 25, "maximum": 45},
        "objective_target_ids": {"$ref": "#/$defs/target_ids"},
        "objectives": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 8}},
        "content_sections": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "section_type", "title", "body", "target_ids"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "section_type": {"enum": ["explanation", "dialogue", "reading", "pronunciation", "review"]}, "title": {"type": "string", "minLength": 2}, "body": {"type": "string", "minLength": 24}, "target_ids": {"$ref": "#/$defs/target_ids"}}}
        },
        "exercises": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/exercise"}},
        "practice": {"type": "object", "additionalProperties": false, "required": ["listening", "speaking", "pronunciation", "writing"], "properties": {"listening": {"$ref": "#/$defs/listening"}, "speaking": {"$ref": "#/$defs/prompt"}, "pronunciation": {"$ref": "#/$defs/pronunciation"}, "writing": {"$ref": "#/$defs/writing"}}}
      }
    },
    "exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "target_ids", "prompt", "media_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "type": {"enum": ["multiple_choice", "fill_blank", "matching", "ordering", "reading", "listening", "speaking", "writing"]},
        "target_ids": {"$ref": "#/$defs/target_ids"},
        "prompt": {"type": "string", "minLength": 12},
        "media_required": {"const": false},
        "options": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "correct_answer": {"type": "string", "minLength": 1},
        "acceptable_answers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pairs": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"type": "string", "minLength": 1}, "right": {"type": "string", "minLength": 1}}}},
        "items": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "correct_order": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "stimulus": {"type": "string", "minLength": 12},
        "questions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["question", "acceptable_answers"], "properties": {"question": {"type": "string", "minLength": 5}, "acceptable_answers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
        "rubric": {"type": "object", "additionalProperties": false, "required": ["criteria"], "properties": {"criteria": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 8}}}}
      }
    },
    "prompt": {"type": "object", "additionalProperties": false, "required": ["instruction", "goal", "target_ids", "constraints"], "properties": {"instruction": {"type": "string", "minLength": 16}, "goal": {"type": "string", "minLength": 8}, "target_ids": {"$ref": "#/$defs/target_ids"}, "constraints": {"$ref": "#/$defs/constraints"}}},
    "listening": {"type": "object", "additionalProperties": false, "required": ["instruction", "goal", "target_ids", "transcript", "question", "answer", "media_required", "constraints"], "properties": {"instruction": {"type": "string", "minLength": 16}, "goal": {"type": "string", "minLength": 8}, "target_ids": {"$ref": "#/$defs/target_ids"}, "transcript": {"type": "string", "minLength": 16}, "question": {"type": "string", "minLength": 8}, "answer": {"type": "string", "minLength": 1}, "media_required": {"const": false}, "constraints": {"$ref": "#/$defs/constraints"}}},
    "pronunciation": {"type": "object", "additionalProperties": false, "required": ["instruction", "goal", "target_ids", "target", "without_audio", "constraints"], "properties": {"instruction": {"type": "string", "minLength": 16}, "goal": {"type": "string", "minLength": 8}, "target_ids": {"$ref": "#/$defs/target_ids"}, "target": {"type": "string", "minLength": 3}, "without_audio": {"const": "NOT_ASSESSED"}, "constraints": {"$ref": "#/$defs/constraints"}}},
    "writing": {"type": "object", "additionalProperties": false, "required": ["instruction", "goal", "target_ids", "feedback_boundary", "constraints"], "properties": {"instruction": {"type": "string", "minLength": 16}, "goal": {"type": "string", "minLength": 8}, "target_ids": {"$ref": "#/$defs/target_ids"}, "feedback_boundary": {"const": "FEEDBACK_ONLY_NO_REPLACEMENT"}, "constraints": {"$ref": "#/$defs/constraints"}}}
  }
}

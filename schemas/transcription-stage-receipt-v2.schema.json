{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/transcription-stage-receipt-v2.schema.json",
  "title": "English Master M13 Hardened Transcription Stage Receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "receipt_id", "run_id", "sequence", "stage", "input_sha256", "status", "checked_at", "checks", "fixture_only", "network_accessed"],
  "properties": {
    "schema_version": {"const": "2.0"}, "record_type": {"const": "transcription_stage_receipt"},
    "receipt_id": {"type": "string", "pattern": "^transreceipt_[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^transrun_[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 5},
    "stage": {"enum": ["AUTHORIZATION", "REQUEST", "PROCESSING_PLAN", "SEGMENTS", "ARTIFACT"]},
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "status": {"const": "PASS"},
    "checked_at": {"type": "string", "format": "date-time"},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["M12_V2_BINDING", "SOURCE_REGISTRY", "RECORD_PERMISSION_EVIDENCE", "TRANSCRIPT_PERMISSION", "TIMESTAMP_PERMISSION", "REQUEST_BINDING", "FIXTURE_BOUNDARY", "NO_MEDIA_ACCESS", "NO_TRANSFORM", "TOOL_MODEL_PROVENANCE", "PARAMETER_BINDING", "SEGMENT_SEQUENCE", "TIMESTAMP_BOUNDS", "SPEAKER_ANONYMIZATION", "TEXT_CONSISTENCY", "PROCESSING_PLAN_BINDING", "SCHEMA"]}},
    "fixture_only": {"const": true}, "network_accessed": {"const": false}
  }
}

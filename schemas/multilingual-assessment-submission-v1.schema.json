{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/multilingual-assessment-submission-v1.schema.json",
  "title": "English Master language-bound assessment submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "language_code", "submission"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "multilingual_assessment_submission"},
    "language_code": {"$ref": "#/$defs/supportedLanguageCode"},
    "submission": {"$ref": "assessment-submission-v1.schema.json"}
  },
  "$defs": {
    "supportedLanguageCode": {"type": "string", "enum": ["en", "de"]}
  }
}

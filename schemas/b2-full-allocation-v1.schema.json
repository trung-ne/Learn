{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/b2-full-allocation-v1.schema.json",
  "title": "English Master full B2 allocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "population_sha256", "blueprint_sha256", "targets", "lessons"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "b2_full_allocation"},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "blueprint_sha256": {"$ref": "#/$defs/sha256"},
    "targets": {
      "type": "array", "minItems": 20, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "tier", "dimension", "broad_target_id", "prerequisites"],
        "properties": {
          "id": {"type": "string", "pattern": "^b2t_u[0-9]{2}_[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 3},
          "tier": {"enum": ["B2.1", "B2.2"]},
          "dimension": {"enum": ["grammar", "vocabulary_senses", "functions", "pronunciation", "discourse", "pragmatics", "collocations", "lexical_chunks", "topics", "skills"]},
          "broad_target_id": {"type": "string", "pattern": "^kg_b2_[12]_[a-z_]+$"},
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^b2t_u[0-9]{2}_[a-z0-9_]+$"}}
        }
      }
    },
    "lessons": {
      "type": "array", "minItems": 50, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lesson_id", "tier", "unit_id", "sequence", "lesson_kind", "topic", "language_focus", "prerequisite_lesson_ids", "target_usage", "allowed_exercise_types"],
        "properties": {
          "lesson_id": {"type": "string", "pattern": "^m16b2-v1-b2-u[0-9]{2}-l[0-9]{2}$"},
          "tier": {"enum": ["B2.1", "B2.2"]},
          "unit_id": {"type": "string", "pattern": "^m16b2-v1-b2-u[0-9]{2}$"},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 50},
          "lesson_kind": {"enum": ["LEARN", "REVIEW"]},
          "topic": {"type": "string", "minLength": 3},
          "language_focus": {"type": "string", "minLength": 3},
          "prerequisite_lesson_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "target_usage": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["target_id", "usage"],
              "properties": {"target_id": {"type": "string", "pattern": "^b2t_u[0-9]{2}_[a-z0-9_]+$"}, "usage": {"enum": ["INTRODUCE", "PRACTISE", "REVIEW", "REQUIRE"]}}
            }
          },
          "allowed_exercise_types": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/exercise_type"}}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exercise_type": {"enum": ["multiple_choice", "fill_blank", "matching", "ordering", "reading", "listening", "speaking", "writing"]}
  }
}

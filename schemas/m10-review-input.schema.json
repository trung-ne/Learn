{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m10-review-input.schema.json",
  "title": "English Master M10 non-promotable M9 review input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "input_id", "source_milestone", "evidence_purpose", "promotion_status", "selection_id", "subject_id", "content_type", "artifact_sha256", "machine_report_sha256", "review_role", "capture", "review_prompt", "review_prompt_sha256", "raw_response", "raw_response_sha256", "decision", "checklist", "findings", "limitations", "observed_at", "imported_at", "content_lifecycle_status", "human_reviewed", "release_approved", "provider_authenticated"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "m10_review_input"},
    "input_id": {"type": "string", "pattern": "^m10input_[a-f0-9]{64}$"},
    "source_milestone": {"const": "M9"},
    "evidence_purpose": {"const": "M10_REVISION_INPUT"},
    "promotion_status": {"const": "NON_PROMOTABLE"},
    "selection_id": {"type": "string", "pattern": "^m9select_[a-f0-9]{64}$"},
    "subject_id": {"type": "string", "pattern": "^m9sub_[a-f0-9]{64}$"},
    "content_type": {"enum": ["LESSON", "EXERCISE_SET", "AI_PRACTICE_PROMPT"]},
    "modality": {"enum": ["LISTENING", "SPEAKING", "PRONUNCIATION", "WRITING"]},
    "artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "machine_report_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "review_role": {"enum": ["LINGUISTIC_AI_REVIEWER", "PEDAGOGICAL_AI_REVIEWER"]},
    "capture": {"$ref": "#/$defs/capture"},
    "review_prompt": {"type": "string", "minLength": 1},
    "review_prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "raw_response": {"$ref": "#/$defs/rawResponse"},
    "raw_response_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "decision": {"enum": ["APPROVE", "NEEDS_REVISION", "REJECT"]},
    "checklist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observed_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/orderableDateTime"}, {"const": "UNKNOWN"}]},
    "imported_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "content_lifecycle_status": {"const": "UNREVIEWED"},
    "human_reviewed": {"const": false},
    "release_approved": {"const": false},
    "provider_authenticated": {"const": false}
  },
  "$defs": {
    "capture": {"type": "object", "additionalProperties": false, "required": ["capture_mode", "provider", "model", "execution_id", "provider_authenticated", "observed_at"], "properties": {"capture_mode": {"enum": ["SESSION_CAPTURED", "PROVIDER_CAPTURED", "TEST_ONLY"]}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "execution_id": {"type": "string", "minLength": 1}, "provider_authenticated": {"const": false}, "observed_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/orderableDateTime"}, {"const": "UNKNOWN"}]}}},
    "rawResponse": {"type": "object", "additionalProperties": false, "required": ["decision", "checklist", "findings", "limitations"], "properties": {"decision": {"enum": ["APPROVE", "NEEDS_REVISION", "REJECT"]}, "checklist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["criterion", "result", "notes"], "properties": {"criterion": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}, "notes": {"type": "string", "minLength": 1}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["severity", "category", "description"], "properties": {"severity": {"enum": ["MINOR", "MAJOR", "CRITICAL"]}, "category": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "recommendation": {"type": "string"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/curriculum-graph.schema.json",
  "title": "English Master M5 curriculum dependency graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "curriculum_version", "ordering_semantics", "nodes", "edges", "topological_order"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "curriculum_version": {"type": "string", "pattern": "^[0-9]{8}$"},
    "ordering_semantics": {
      "type": "object", "additionalProperties": false, "required": ["ordering_edge_types", "non_ordering_edge_types", "edge_direction"],
      "properties": {
        "ordering_edge_types": {"type": "array", "prefixItems": [{"const": "lesson_prerequisite"}, {"const": "unit_ordering"}, {"const": "taxonomy_prerequisite"}], "items": false},
        "non_ordering_edge_types": {"type": "array", "prefixItems": [{"const": "introduction"}, {"const": "review"}, {"const": "related_non_ordering"}], "items": false},
        "edge_direction": {"const": "FROM_PREDECESSOR_OR_SOURCE_TO_DEPENDENT_OR_TARGET"}
      }
    },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "type", "sequence_key"],
        "properties": {
          "id": {"$ref": "curriculum-common.schema.json#/$defs/curriculumNodeId"},
          "type": {"enum": ["unit", "lesson", "review", "taxonomy_concept", "vocabulary_sense"]},
          "parent_id": {"type": "string", "minLength": 1},
          "sequence_key": {"type": "string", "pattern": "^[0-9]{2}(?:\\.[0-9]{2})?(?:\\.[0-9]{2})?$"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "type"],
        "properties": {
          "from": {"$ref": "curriculum-common.schema.json#/$defs/curriculumNodeId"},
          "to": {"$ref": "curriculum-common.schema.json#/$defs/curriculumNodeId"},
          "type": {"enum": ["lesson_prerequisite", "unit_ordering", "taxonomy_prerequisite", "introduction", "review", "related_non_ordering"]}
        }
      }
    },
    "topological_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "curriculum-common.schema.json#/$defs/curriculumNodeId"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/source.schema.json",
  "title": "English Master source registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_name", "source_type", "source_url", "status", "terms_of_use", "registered_at", "registered_by"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "source_id": {"$ref": "common.schema.json#/$defs/sourceId"},
    "source_name": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "source_type": {"type": "string", "enum": ["dataset", "api", "dump", "crawlable", "other"]},
    "source_url": {"type": "string", "format": "uri"},
    "status": {"$ref": "common.schema.json#/$defs/sourceStatus"},
    "license": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "license_url": {"type": "string", "format": "uri"},
    "terms_of_use": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "registered_at": {"$ref": "common.schema.json#/$defs/isoDateTime"},
    "registered_by": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "QUARANTINED"}}, "required": ["status"]},
      "then": {
        "anyOf": [
          {"properties": {"license": {"const": "UNKNOWN"}}, "required": ["license"]},
          {"required": ["license", "license_url"]}
        ]
      },
      "else": {
        "required": ["license", "license_url"],
        "properties": {"license": {"not": {"const": "UNKNOWN"}}}
      }
    }
  ]
}

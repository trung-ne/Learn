{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/assessment-submission-v1.schema.json",
  "title": "English Master assessment submission v1",
  "description": "A complete response set for one immutable assessment package. Response item_id values must be unique and exactly match the package inventory; that cross-document rule is enforced by the scorer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "assessment_id",
    "package_sha256",
    "seen_at",
    "responses",
    "submission_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "assessment_submission"},
    "assessment_id": {"type": "string", "pattern": "^(?:lesson-quiz|unit-test|level-test|placement)-[a-z0-9][a-z0-9._-]*$"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "seen_at": {"$ref": "#/$defs/utcDateTime"},
    "responses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/response"}
    },
    "submission_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "answer"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^item-[a-z0-9._-]+$"},
        "answer": {
          "oneOf": [
            {"type": "string"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["left", "right"],
                "properties": {
                  "left": {"type": "string", "minLength": 1},
                  "right": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/qa-engine-decision.schema.json",
  "title": "English Master M8 development decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "decision_id", "engine_run_id",
    "m7_batch_id", "candidate_attempt_id", "candidate_sha256",
    "ai_review_id", "ai_review_sha256", "terminal_result",
    "content_lifecycle_status", "receipt_sha256s", "run_evidence_sha256",
    "decided_at", "human_reviewed", "release_approved", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "qa_engine_decision"},
    "decision_id": {"type": "string", "pattern": "^qaedecision_[a-f0-9]{64}$"},
    "engine_run_id": {"type": "string", "pattern": "^qaerun_[a-f0-9]{64}$"},
    "m7_batch_id": {"type": "string", "pattern": "^m7devbatch_[a-f0-9]{64}$"},
    "candidate_attempt_id": {"type": "string", "pattern": "^qaeattempt_[a-f0-9]{64}$"},
    "candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "ai_review_id": {"type": "string", "pattern": "^qaeaireview_[a-f0-9]{64}$"},
    "ai_review_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "terminal_result": {"const": "DEVELOPMENT_APPROVED"},
    "content_lifecycle_status": {"const": "UNREVIEWED"},
    "receipt_sha256s": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "common.schema.json#/$defs/sha256"}, "uniqueItems": true
    },
    "run_evidence_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "decided_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "human_reviewed": {"const": false},
    "release_approved": {"const": false},
    "limitations": {
      "type": "array", "minItems": 2,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-master.local/schemas/exercise-generation-authorization.schema.json","title":"English Master exercise generation authorization",
  "type":"object","additionalProperties":false,
  "required":["schema_version","record_type","authorization_id","m6_batch_id","m6_batch_sha256","snapshot_binding","lesson_bindings","policy"],
  "properties":{
    "schema_version":{"const":"1.0"},"record_type":{"const":"exercise_generation_authorization"},
    "authorization_id":{"type":"string","pattern":"^m7auth_[a-f0-9]{64}$"},
    "m6_batch_id":{"type":"string","pattern":"^m6devbatch_[a-f0-9]{64}$"},"m6_batch_sha256":{"$ref":"common.schema.json#/$defs/sha256"},
    "snapshot_binding":{"type":"object","minProperties":1},
    "lesson_bindings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["lesson_id","lesson_sha256","audit_sha256","lesson_path","audit_path"],"properties":{"lesson_id":{"$ref":"common.schema.json#/$defs/lessonId"},"lesson_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"audit_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"lesson_path":{"type":"string","pattern":"^[^\\\\/].*"},"audit_path":{"type":"string","pattern":"^[^\\\\/].*"}}}},
    "policy":{"type":"object","additionalProperties":false,"required":["external_stimuli","external_media","authored_inline_text","allow_m8_artifacts"],"properties":{"external_stimuli":{"const":"FORBIDDEN"},"external_media":{"const":"FORBIDDEN"},"authored_inline_text":{"const":"REQUIRED"},"allow_m8_artifacts":{"const":false}}}
  }
}
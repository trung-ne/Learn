{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/a1-full-packet-v2.schema.json",
  "title": "English Master full A1 packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "packet_id", "lesson_id", "tier", "unit_id", "sequence", "topic", "language_focus", "outline_targets", "prerequisite_lesson_ids", "target_usage", "allowed_exercise_types", "title", "duration_minutes", "objective_target_ids", "objectives", "content_sections", "exercises", "practice", "content_status", "provenance", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "a1_full_packet"},
    "packet_id": {"type": "string", "pattern": "^a1full-packet-[0-9]{2}$"},
    "lesson_id": {"type": "string", "pattern": "^m16a1-v1-a1-u[0-9]{2}-l[0-9]{2}$"},
    "tier": {"enum": ["A1.1", "A1.2"]},
    "unit_id": {"type": "string", "pattern": "^m16a1-v1-a1-u[0-9]{2}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 50},
    "topic": {"type": "string", "minLength": 3},
    "language_focus": {"type": "string", "minLength": 3},
    "outline_targets": {"type": "array", "minItems": 1},
    "prerequisite_lesson_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "target_usage": {"type": "array", "minItems": 1},
    "allowed_exercise_types": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "title": {"type": "string", "minLength": 3},
    "duration_minutes": {"type": "integer", "minimum": 25, "maximum": 45},
    "objective_target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "objectives": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}},
    "content_sections": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "exercises": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "practice": {"type": "object", "additionalProperties": false, "required": ["listening", "speaking", "pronunciation", "writing"], "properties": {"listening": {"type": "object"}, "speaking": {"type": "object"}, "pronunciation": {"type": "object"}, "writing": {"type": "object"}}},
    "content_status": {"const": "UNREVIEWED"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["content_origin", "population_sha256", "blueprint_sha256", "allocation_sha256", "content_manifest_sha256", "content_unit_sha256"],
      "properties": {"content_origin": {"const": "PROJECT_AUTHORED"}, "population_sha256": {"$ref": "#/$defs/sha256"}, "blueprint_sha256": {"$ref": "#/$defs/sha256"}, "allocation_sha256": {"$ref": "#/$defs/sha256"}, "content_manifest_sha256": {"$ref": "#/$defs/sha256"}, "content_unit_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/web-speaking-inventory.schema.json",
  "title": "English Master web speaking practice inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventoryVersion", "protocols"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "inventoryVersion": { "type": "string", "minLength": 1 },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocol" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "grammar", "vocabulary", "fluency", "pronunciation", "coherence", "appropriacy"],
      "properties": {
        "overall": { "const": "NOT_ASSESSED" },
        "grammar": { "const": "NOT_ASSESSED" },
        "vocabulary": { "const": "NOT_ASSESSED" },
        "fluency": { "const": "NOT_ASSESSED" },
        "pronunciation": { "const": "NOT_ASSESSED" },
        "coherence": { "const": "NOT_ASSESSED" },
        "appropriacy": { "const": "NOT_ASSESSED" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "language", "band", "tier", "unitId", "lessonId", "title", "topic", "instruction",
        "assessment", "contentStatus"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "language": { "enum": ["en", "de"] },
        "band": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "tier": { "type": "string", "pattern": "^(A1|A2|B1|B2|C1|C2)\\.[12]$" },
        "unitId": { "$ref": "#/$defs/identifier" },
        "lessonId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "topic": { "$ref": "#/$defs/nonEmptyString" },
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "goal": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/textList" },
        "checklist": { "$ref": "#/$defs/textList" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "contentStatus": { "const": "UNREVIEWED" }
      },
      "allOf": [
        {
          "if": { "properties": { "language": { "const": "en" } }, "required": ["language"] },
          "then": { "required": ["goal", "constraints"], "not": { "required": ["checklist"] } },
          "else": { "required": ["checklist"], "not": { "anyOf": [{ "required": ["goal"] }, { "required": ["constraints"] }] } }
        }
      ]
    }
  }
}

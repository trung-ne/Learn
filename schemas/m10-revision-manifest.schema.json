{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m10-revision-manifest.schema.json",
  "title": "English Master M10 terminal revision manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "manifest_id", "terminal_state", "finding_batch", "revision_requests", "dispositions", "created_at", "fresh_m9_required", "content_lifecycle_status", "development_approved", "provider_authenticated", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "m10_revision_manifest"},
    "manifest_id": {"type": "string", "pattern": "^m10manifest_[a-f0-9]{64}$"},
    "terminal_state": {"enum": ["READY_FOR_FRESH_M9", "RETRY_EXHAUSTED", "ESCALATED", "OPERATIONAL_FAILURE"]},
    "finding_batch": {"$ref": "#/$defs/reference"},
    "revision_requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requestReference"}},
    "dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/disposition"}},
    "created_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "fresh_m9_required": {"const": true},
    "content_lifecycle_status": {"const": "UNREVIEWED"},
    "development_approved": {"const": false},
    "provider_authenticated": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}},
    "inventory": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "governance_runs": {"type": "array", "items": {"$ref": "#/$defs/runReference"}}
  },
  "allOf": [
    {"if": {"properties": {"terminal_state": {"const": "READY_FOR_FRESH_M9"}}}, "then": {"properties": {"dispositions": {"items": {"allOf": [{"$ref": "#/$defs/disposition"}, {"properties": {"status": {"const": "RESOLVED"}}, "required": ["successor_evidence"]}]}}}}},
    {"if": {"properties": {"terminal_state": {"const": "ESCALATED"}}}, "then": {"properties": {"dispositions": {"contains": {"properties": {"status": {"const": "ESCALATED"}}, "required": ["status"]}}}}},
    {"if": {"properties": {"terminal_state": {"const": "RETRY_EXHAUSTED"}}}, "then": {"properties": {"dispositions": {"contains": {"properties": {"status": {"const": "RETRY_EXHAUSTED"}}, "required": ["status"]}}}}}
  ],
  "$defs": {
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[a-z0-9._/-]+\\.json$"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}},
    "requestReference": {"type": "object", "additionalProperties": false, "required": ["request_id", "path", "sha256"], "properties": {"request_id": {"type": "string", "pattern": "^m10request_[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^requests/[a-z0-9._-]+\\.json$"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}},
    "runReference": {"type": "object", "additionalProperties": false, "required": ["run_id", "path", "sha256"], "properties": {"run_id": {"type": "string", "pattern": "^m10run_[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^runs/[a-z0-9._/-]+\\.json$"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}},
    "successorEvidence": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {"kind": {"enum": ["M6_SUCCESSOR_BATCH", "M7_SUCCESSOR_BATCH", "M8_2_SUCCESSOR_PILOT", "M10_VERIFICATION"]}, "path": {"type": "string", "pattern": "^[a-z0-9._/-]+\\.json$"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}},
    "disposition": {"type": "object", "additionalProperties": false, "required": ["request_id", "request_sha256", "status"], "properties": {"request_id": {"type": "string", "pattern": "^m10request_[a-f0-9]{64}$"}, "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "status": {"enum": ["RESOLVED", "ESCALATED", "RETRY_EXHAUSTED"]}, "successor_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/successorEvidence"}}, "unresolved_issues": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}}}, "allOf": [{"if": {"properties": {"status": {"const": "RESOLVED"}}}, "then": {"required": ["successor_evidence"]}}, {"if": {"properties": {"status": {"enum": ["ESCALATED", "RETRY_EXHAUSTED"]}}}, "then": {"required": ["unresolved_issues"]}}]}
  }
}

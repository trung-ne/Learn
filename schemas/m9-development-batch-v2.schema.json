{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/m9-development-batch-v2.schema.json",
  "title": "English Master active M9 full-population development batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "batch_id", "selection_id", "selection_sha256", "approval_tier", "content_lifecycle_status", "created_at", "subjects", "aggregate_report", "limitations", "inventory"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "m9_development_batch"},
    "batch_id": {"type": "string", "pattern": "^m9devbatch_[a-f0-9]{64}$"},
    "selection_id": {"type": "string", "pattern": "^m9select_[a-f0-9]{64}$"},
    "selection_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "approval_tier": {"const": "DEVELOPMENT_APPROVED"},
    "content_lifecycle_status": {"const": "UNREVIEWED"},
    "created_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"},
    "subjects": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"$ref": "#/$defs/subject"}, "uniqueItems": true},
    "aggregate_report": {"$ref": "#/$defs/aggregate"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "inventory": {"type": "array", "minItems": 181, "maxItems": 181, "items": {"$ref": "#/$defs/inventory"}, "uniqueItems": true}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "machine_report_path", "machine_report_sha256", "ai_reviews"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^m9sub_[a-f0-9]{64}$"},
        "machine_report_path": {"$ref": "#/$defs/safePath"},
        "machine_report_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "ai_reviews": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/review"}, "uniqueItems": true}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_role", "path", "sha256"],
      "properties": {
        "review_role": {"enum": ["LINGUISTIC_AI_REVIEWER", "PEDAGOGICAL_AI_REVIEWER"]},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_scope", "selected_subject_count", "machine_pass_count", "ai_review_count", "blocking_finding_count", "unreviewed_outside_selection"],
      "properties": {
        "selection_scope": {"const": "FULL_POPULATION"},
        "selected_subject_count": {"const": 60},
        "machine_pass_count": {"const": 60},
        "ai_review_count": {"const": 120},
        "blocking_finding_count": {"const": 0},
        "unreviewed_outside_selection": {"const": false}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/curriculum-common.schema.json",
  "title": "English Master M5 curriculum common definitions",
  "$defs": {
    "officialCefr": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]},
    "internalTier": {"enum": ["A1.1", "A1.2", "A2.1", "A2.2", "B1.1", "B1.2", "B2.1", "B2.2", "C1.1", "C1.2", "C2.1", "C2.2"]},
    "unitId": {"$ref": "common.schema.json#/$defs/unitId"},
    "lessonId": {"$ref": "common.schema.json#/$defs/lessonId"},
    "reviewId": {"type": "string", "pattern": "^(A1|A2|B1|B2|C1|C2)-U(0[1-9]|[1-9][0-9])-REV$"},
    "conceptId": {"$ref": "common.schema.json#/$defs/conceptId"},
    "vocabularySenseId": {"$ref": "common.schema.json#/$defs/vocabularySenseId"},
    "curriculumNodeId": {"type": "string", "pattern": "^(?:[A-C][12](?:\\.[12])?-U(?:0[1-9]|[1-9][0-9])(?:-L(?:0[1-9]|[1-9][0-9])|-REV)?|concept_[a-z0-9]+(?:_[a-z0-9]+)*|vocab_[a-z]{2}_[a-z0-9]+(?:_[a-z0-9]+)*_[0-9]{3})$"},
    "outlineText": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[^\\r\\n<>`]+$"},
    "uniqueConceptIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/conceptId"}},
    "uniqueVocabularyIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/vocabularySenseId"}},
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["listening", "speaking", "spoken_interaction", "reading", "writing", "mediation", "grammar", "vocabulary_senses", "collocations", "lexical_chunks", "pronunciation", "communicative_functions", "topics", "discourse", "pragmatics", "assessment_capabilities"]}
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["listening", "speaking", "spoken_interaction", "reading", "writing", "mediation"]}
    },
    "outlineStatus": {"const": "OUTLINE_ONLY"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/ai-practice-prompt-artifact.schema.json",
  "title": "English Master M8.2 lesson-bound AI practice prompt artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "prompt_artifact_id", "authorization_id", "authorization_sha256", "request_id", "request_sha256", "lesson_id", "lesson_sha256", "lesson_audit_sha256", "cefr_level", "modality", "scope", "prompt_version", "messages", "payload", "provenance", "content_lifecycle_status", "human_reviewed", "release_approved", "rendered_system_sha256", "rendered_initial_sha256", "artifact_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "ai_practice_prompt_artifact"},
    "prompt_artifact_id": {"type": "string", "pattern": "^aipprompt_[a-f0-9]{64}$"}, "authorization_id": {"type": "string", "pattern": "^aipauth_[a-f0-9]{64}$"}, "authorization_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "request_id": {"type": "string", "pattern": "^aipreq_[a-f0-9]{64}$"}, "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "lesson_id": {"$ref": "common.schema.json#/$defs/lessonId"}, "lesson_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "lesson_audit_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "cefr_level": {"$ref": "common.schema.json#/$defs/cefrLevel"},
    "modality": {"enum": ["LISTENING", "SPEAKING", "PRONUNCIATION", "WRITING"]}, "scope": {"$ref": "#/$defs/scope"}, "prompt_version": {"const": "M8_2_AI_PRACTICE_v9"}, "messages": {"$ref": "#/$defs/messages"}, "payload": {"type": "object"}, "provenance": {"$ref": "#/$defs/provenance"},
    "content_lifecycle_status": {"const": "UNREVIEWED"}, "human_reviewed": {"const": false}, "release_approved": {"const": false}, "rendered_system_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "rendered_initial_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"modality": {"const": "LISTENING"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/listeningPayload"}}}},
    {"if": {"properties": {"modality": {"const": "SPEAKING"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/speakingPayload"}}}},
    {"if": {"properties": {"modality": {"const": "PRONUNCIATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/pronunciationPayload"}}}},
    {"if": {"properties": {"modality": {"const": "WRITING"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/writingPayload"}}}}
  ],
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scope": {"type": "object", "additionalProperties": false, "required": ["known_vocabulary", "target_vocabulary", "review_vocabulary", "known_grammar", "target_grammar", "review_grammar", "known_functions", "target_functions", "review_functions", "known_pronunciation", "target_pronunciation", "review_pronunciation", "prerequisite_context", "taxonomy_context", "source_section_ids"], "properties": {"known_vocabulary": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/vocabularySenseId"}, "uniqueItems": true}, "target_vocabulary": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/vocabularySenseId"}, "uniqueItems": true}, "review_vocabulary": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/vocabularySenseId"}, "uniqueItems": true}, "known_grammar": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "target_grammar": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "review_grammar": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "known_functions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "target_functions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "review_functions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "known_pronunciation": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "target_pronunciation": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "review_pronunciation": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "prerequisite_context": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/lessonId"}, "uniqueItems": true}, "taxonomy_context": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true}, "source_section_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^section_[a-z0-9_]+$"}, "uniqueItems": true}}},
    "messages": {"type": "object", "additionalProperties": false, "required": ["system", "initial_learner_visible"], "properties": {"system": {"type": "string", "minLength": 1}, "initial_learner_visible": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "external_text", "external_media", "generator", "generator_version", "curriculum_version", "provider", "model", "provider_run_id", "provider_authenticated", "generated_at"], "properties": {"origin": {"const": "PROJECT_AUTHORED"}, "external_text": {"const": false}, "external_media": {"const": false}, "generator": {"const": "english_master.ai_practice"}, "generator_version": {"const": "2.0"}, "curriculum_version": {"type": "string", "minLength": 1}, "provider": {"const": "UNKNOWN"}, "model": {"const": "UNKNOWN"}, "provider_run_id": {"const": "UNKNOWN"}, "provider_authenticated": {"const": false}, "generated_at": {"$ref": "common.schema.json#/$defs/orderableDateTime"}}},
    "turnPolicy": {"type": "object", "additionalProperties": false, "required": ["one_question_at_a_time", "maximum_questions_per_turn"], "properties": {"one_question_at_a_time": {"const": true}, "maximum_questions_per_turn": {"const": 1}}},
    "listeningPayload": {"type": "object", "additionalProperties": false, "required": ["system_role", "learner_visible_opening", "private_transcript", "private_answer", "delivery", "transcript_release", "question_queue", "answer_evaluation", "turn_policy", "completion_criteria"], "properties": {"system_role": {"const": "lesson-bound listening tutor"}, "learner_visible_opening": {"type": "string", "minLength": 1}, "private_transcript": {"type": "string", "minLength": 1}, "private_answer": {"type": "string", "minLength": 1}, "delivery": {"type": "object", "additionalProperties": false, "required": ["required_mode", "text_only_completion"], "properties": {"required_mode": {"const": "AUDIO_OR_SPEECH"}, "text_only_completion": {"const": "NOT_COMPLETED"}}}, "transcript_release": {"type": "object", "additionalProperties": false, "required": ["allowed_after", "initially_hidden"], "properties": {"allowed_after": {"const": "LEARNER_ATTEMPT_OR_EXPLICIT_REQUEST"}, "initially_hidden": {"const": true}}}, "question_queue": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["question_id", "text", "expected_answer"], "properties": {"question_id": {"const": "q1"}, "text": {"type": "string", "minLength": 1}, "expected_answer": {"type": "string", "minLength": 1}}}}, "answer_evaluation": {"type": "object", "additionalProperties": false, "required": ["accept_equivalent_spelling_and_number_formatting", "require_exact_punctuation"], "properties": {"accept_equivalent_spelling_and_number_formatting": {"const": true}, "require_exact_punctuation": {"const": false}}}, "turn_policy": {"$ref": "#/$defs/turnPolicy"}, "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "speakingPayload": {"type": "object", "additionalProperties": false, "required": ["system_role", "learner_role", "assistant_role", "scenario", "communicative_goal", "success_condition", "stop_condition", "turn_policy", "feedback_policy", "opening_turn"], "properties": {"system_role": {"const": "lesson-bound roleplay partner"}, "learner_role": {"type": "string", "minLength": 1}, "assistant_role": {"type": "string", "minLength": 1}, "scenario": {"type": "string", "minLength": 1}, "communicative_goal": {"type": "string", "minLength": 1}, "success_condition": {"type": "string", "minLength": 1}, "stop_condition": {"type": "string", "minLength": 1}, "turn_policy": {"type": "object", "additionalProperties": false, "required": ["one_question_at_a_time", "maximum_questions_per_turn", "maximum_roleplay_turns"], "properties": {"one_question_at_a_time": {"const": true}, "maximum_questions_per_turn": {"const": 1}, "maximum_roleplay_turns": {"const": 6}}}, "feedback_policy": {"type": "object", "additionalProperties": false, "required": ["timing", "maximum_priorities", "target_references"], "properties": {"timing": {"const": "AFTER_ROLEPLAY"}, "maximum_priorities": {"const": 2}, "target_references": {"$ref": "#/$defs/stringArray"}}}, "opening_turn": {"type": "string", "minLength": 1}}},
    "pronunciationPayload": {"type": "object", "additionalProperties": false, "required": ["system_role", "learner_visible_opening", "practice_targets", "target_utterance", "feature_guidance", "assessment_policy", "external_audio_included", "turn_policy"], "properties": {"system_role": {"const": "lesson-bound pronunciation practice tutor"}, "learner_visible_opening": {"type": "string", "minLength": 1}, "practice_targets": {"$ref": "#/$defs/stringArray"}, "target_utterance": {"type": "string", "minLength": 1}, "feature_guidance": {"type": "string", "minLength": 1}, "assessment_policy": {"type": "object", "additionalProperties": false, "required": ["required_input", "without_audio_result", "forbidden_without_audio"], "properties": {"required_input": {"const": "AUDIO"}, "without_audio_result": {"const": "NOT_ASSESSED"}, "forbidden_without_audio": {"type": "array", "uniqueItems": true, "allOf": [{"contains": {"const": "score"}}, {"contains": {"const": "phonetic_correctness_judgment"}}, {"contains": {"const": "accent_inference"}}]}}}, "external_audio_included": {"const": false}, "turn_policy": {"$ref": "#/$defs/turnPolicy"}}},
    "writingPayload": {"type": "object", "additionalProperties": false, "required": ["system_role", "writing_task", "communicative_goal", "states", "draft_required_before_feedback", "feedback_policy", "rubric_targets", "turn_policy"], "properties": {"system_role": {"const": "lesson-bound writing feedback tutor"}, "writing_task": {"type": "string", "minLength": 1}, "communicative_goal": {"type": "string", "minLength": 1}, "states": {"const": ["AWAIT_DRAFT", "FEEDBACK", "REVISION"]}, "draft_required_before_feedback": {"const": true}, "feedback_policy": {"type": "object", "additionalProperties": false, "required": ["maximum_priorities", "preserve_learner_meaning", "full_replacement_forbidden", "model_answer_label_required"], "properties": {"maximum_priorities": {"const": 3}, "preserve_learner_meaning": {"const": true}, "full_replacement_forbidden": {"const": true}, "model_answer_label_required": {"const": true}}}, "rubric_targets": {"$ref": "#/$defs/stringArray"}, "turn_policy": {"type": "object", "additionalProperties": false, "required": ["maximum_clarification_or_revision_questions_per_turn"], "properties": {"maximum_clarification_or_revision_questions_per_turn": {"const": 1}}}}}
  }
}

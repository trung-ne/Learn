{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/web-reading-inventory.schema.json",
  "title": "English Master web reading source mapping inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_version", "content_status", "records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "inventory_version": { "type": "string", "minLength": 1 },
    "content_status": { "const": "UNREVIEWED" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceKind": { "enum": ["exercise", "section"] },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense_id", "surface", "start", "end"],
      "properties": {
        "sense_id": { "$ref": "#/$defs/identifier" },
        "surface": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "band", "lesson_id", "packet_sha256", "source_kind", "source_id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "band": { "enum": ["A1", "A2", "B1", "C1", "C2"] },
        "lesson_id": { "$ref": "#/$defs/identifier" },
        "packet_sha256": { "$ref": "#/$defs/sha256" },
        "source_kind": { "$ref": "#/$defs/sourceKind" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "capability_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "word_sense_occurrences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/occurrence" }
        }
      }
    }
  }
}

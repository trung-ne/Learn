{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/a1-full-content-manifest-v2.schema.json",
  "title": "English Master full A1 content manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "allocation_sha256", "content_origin", "units", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "a1_full_content_manifest"},
    "allocation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_origin": {"const": "PROJECT_AUTHORED"},
    "units": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["unit_id", "tier", "path", "sha256"], "properties": {"unit_id": {"type": "string", "pattern": "^m16a1-v1-a1-u[0-9]{2}$"}, "tier": {"enum": ["A1.1", "A1.2"]}, "path": {"type": "string", "pattern": "^units/unit-[0-9]{2}\\.json$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
    },
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

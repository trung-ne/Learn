{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/lesson-generation-authorization.schema.json",
  "title": "English Master M6 lesson generation authorization snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "status", "validated", "approved_at", "approved_by", "curriculum_version", "taxonomy_version", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "authorization_id": {"type": "string", "pattern": "^auth_[a-f0-9]{64}$"},
    "status": {"const": "APPROVED"},
    "validated": {"const": true},
    "approved_at": {"$ref": "common.schema.json#/$defs/isoDateTime"},
    "approved_by": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "curriculum_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "taxonomy_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/authorizedRecord"}
    }
  },
  "$defs": {
    "authorizedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "record_type", "cefr", "status", "definition", "prerequisites", "content_origin"],
      "properties": {
        "id": {"type": "string", "pattern": "^(concept_|vocab_|func_)[a-z0-9_]+$"},
        "record_type": {"enum": ["GRAMMAR", "VOCABULARY_SENSE", "COMMUNICATIVE_FUNCTION", "PRONUNCIATION"]},
        "cefr": {"$ref": "common.schema.json#/$defs/cefrLevel"},
        "status": {"const": "APPROVED"},
        "definition": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "prerequisites": {"type": "array", "items": {"type": "string", "pattern": "^(concept_|vocab_|func_)[a-z0-9_]+$"}, "uniqueItems": true},
        "content_origin": {"enum": ["PROJECT_AUTHORED", "EXTERNAL_APPROVED"]},
        "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
        "source_authorized_for_generation": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"content_origin": {"const": "EXTERNAL_APPROVED"}}, "required": ["content_origin"]},
          "then": {"required": ["provenance", "source_authorized_for_generation"], "properties": {"source_authorized_for_generation": {"const": true}}},
          "else": {"not": {"required": ["provenance"]}}
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-master.local/schemas/lesson-generation-request.schema.json",
  "title": "English Master M6 lesson generation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "authorization_id", "artifact_hashes", "lesson_spec", "graph", "previous_knowledge", "constraints", "generation", "requested_outputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^req_[a-f0-9]{64}$"},
    "authorization_id": {"type": "string", "pattern": "^auth_[a-f0-9]{64}$"},
    "artifact_hashes": {"$ref": "lesson-generation-authorization.schema.json#/$defs/artifactHashes"},
    "lesson_spec": {"$ref": "#/$defs/lessonSpec"},
    "graph": {"$ref": "#/$defs/graph"},
    "previous_knowledge": {"$ref": "#/$defs/referenceSets"},
    "constraints": {"$ref": "#/$defs/constraints"},
    "generation": {"$ref": "#/$defs/generation"},
    "requested_outputs": {"type": "array", "prefixItems": [{"const": "lesson"}], "items": false, "minItems": 1, "maxItems": 1}
  },
  "$defs": {
    "conceptIds": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conceptId"}, "uniqueItems": true},
    "vocabularyIds": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/vocabularySenseId"}, "uniqueItems": true},
    "lessonSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "unit_id", "lesson_number", "cefr", "duration_minutes", "objectives", "grammar_introduced", "grammar_reviewed", "vocabulary_introduced", "vocabulary_reviewed", "functions_introduced", "functions_reviewed", "pronunciation_introduced", "pronunciation_reviewed", "prerequisites"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/lessonId"}, "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "unit_id": {"$ref": "common.schema.json#/$defs/unitId"},
        "lesson_number": {"type": "integer", "minimum": 1, "maximum": 99}, "cefr": {"$ref": "common.schema.json#/$defs/cefrLevel"},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
        "grammar_introduced": {"$ref": "#/$defs/conceptIds"}, "grammar_reviewed": {"$ref": "#/$defs/conceptIds"},
        "vocabulary_introduced": {"$ref": "#/$defs/vocabularyIds"}, "vocabulary_reviewed": {"$ref": "#/$defs/vocabularyIds"},
        "functions_introduced": {"$ref": "#/$defs/conceptIds"}, "functions_reviewed": {"$ref": "#/$defs/conceptIds"},
        "pronunciation_introduced": {"$ref": "#/$defs/conceptIds"}, "pronunciation_reviewed": {"$ref": "#/$defs/conceptIds"},
        "prerequisites": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/lessonId"}, "uniqueItems": true}
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["lesson_order", "prerequisite_edges", "introduction_edges", "review_edges", "resolved_prerequisite_closure"],
      "properties": {
        "lesson_order": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/lessonId"}, "uniqueItems": true},
        "prerequisite_edges": {"$ref": "#/$defs/lessonEdges"}, "introduction_edges": {"$ref": "#/$defs/referenceEdges"}, "review_edges": {"$ref": "#/$defs/lessonEdges"},
        "resolved_prerequisite_closure": {"$ref": "#/$defs/referenceIds"}
      }
    },
    "lessonEdges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "common.schema.json#/$defs/lessonId"}, "to": {"$ref": "common.schema.json#/$defs/lessonId"}}}},
    "referenceEdges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "common.schema.json#/$defs/lessonId"}, "to": {"$ref": "#/$defs/referenceId"}}}},
    "referenceId": {"anyOf": [{"$ref": "common.schema.json#/$defs/conceptId"}, {"$ref": "common.schema.json#/$defs/vocabularySenseId"}]},
    "referenceIds": {"type": "array", "items": {"$ref": "#/$defs/referenceId"}, "uniqueItems": true},
    "referenceSets": {
      "type": "object", "additionalProperties": false,
      "required": ["completed_lessons", "grammar", "vocabulary", "functions", "pronunciation"],
      "properties": {
        "completed_lessons": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/lessonId"}, "uniqueItems": true},
        "grammar": {"$ref": "#/$defs/conceptIds"}, "vocabulary": {"$ref": "#/$defs/vocabularyIds"}, "functions": {"$ref": "#/$defs/conceptIds"}, "pronunciation": {"$ref": "#/$defs/conceptIds"}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["target_cefr", "allowed_grammar", "allowed_vocabulary", "allowed_functions", "allowed_pronunciation", "forbidden_ids", "forbidden_terms", "max_target_vocabulary", "max_sections", "max_section_characters", "max_total_characters"],
      "properties": {
        "target_cefr": {"$ref": "common.schema.json#/$defs/cefrLevel"},
        "allowed_grammar": {"$ref": "#/$defs/conceptIds"}, "allowed_vocabulary": {"$ref": "#/$defs/vocabularyIds"}, "allowed_functions": {"$ref": "#/$defs/conceptIds"}, "allowed_pronunciation": {"$ref": "#/$defs/conceptIds"},
        "forbidden_ids": {"$ref": "#/$defs/referenceIds"}, "forbidden_terms": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
        "max_target_vocabulary": {"type": "integer", "minimum": 0, "maximum": 50}, "max_sections": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_section_characters": {"type": "integer", "minimum": 1, "maximum": 20000}, "max_total_characters": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "generator_version", "provider", "model", "prompt_version", "generated_at", "curriculum_version", "taxonomy_version", "lesson_schema_version", "parameters"],
      "properties": {
        "generator": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "generator_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "provider": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "model": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "prompt_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "generated_at": {"$ref": "common.schema.json#/$defs/isoDateTime"},
        "curriculum_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "taxonomy_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "lesson_schema_version": {"const": "1.0"},
        "parameters": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}, "seed": {"type": "integer"}
      }
    }
  }
}

    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.9",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",

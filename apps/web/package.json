{
  "name": "english-master-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/build-service-worker.mjs && node scripts/report-static-output.mjs",
    "prebuild": "npm run check:snapshot && npm run check:vocabulary-snapshot && npm run check:dictionary-snapshot && npm run check:grammar-snapshot && npm run check:listening-snapshot && npm run check:pronunciation-snapshot && npm run check:speaking-snapshot && npm run check:reading-snapshot && npm run check:writing-snapshot && npm run check:assessment-snapshot",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:snapshot": "node scripts/build-content-snapshot.mjs",
    "check:snapshot": "node scripts/check-content-snapshot.mjs",
    "build:vocabulary-snapshot": "node scripts/build-vocabulary-snapshot.mjs",
    "check:vocabulary-snapshot": "node scripts/check-vocabulary-snapshot.mjs",
    "build:dictionary-snapshot": "node scripts/build-dictionary-snapshot.mjs",
    "check:dictionary-snapshot": "node scripts/check-dictionary-snapshot.mjs",
    "build:grammar-snapshot": "node scripts/build-grammar-snapshot.mjs",
    "check:grammar-snapshot": "node scripts/check-grammar-snapshot.mjs",
    "build:listening-snapshot": "node scripts/build-listening-snapshot.mjs",
    "check:listening-snapshot": "node scripts/check-listening-snapshot.mjs",
    "build:pronunciation-snapshot": "node scripts/build-pronunciation-snapshot.mjs",
    "check:pronunciation-snapshot": "node scripts/check-pronunciation-snapshot.mjs",
    "build:speaking-snapshot": "node scripts/build-speaking-snapshot.mjs",
    "check:speaking-snapshot": "node scripts/check-speaking-snapshot.mjs",
    "build:reading-snapshot": "node scripts/build-reading-snapshot.mjs",
    "check:reading-snapshot": "node scripts/check-reading-snapshot.mjs",
    "build:writing-snapshot": "node scripts/build-writing-snapshot.mjs",
    "check:writing-snapshot": "node scripts/check-writing-snapshot.mjs",
    "build:assessment-snapshot": "node scripts/build-assessment-snapshot.mjs",
    "check:assessment-snapshot": "node scripts/check-assessment-snapshot.mjs"
  },
  "dependencies": {
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.9",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
